// Models view — local inventory + deploy + inference
import { Theme } from "@citrate-ui-kit";

component ModelCard inherits Rectangle {
    in property <string> name;
    in property <string> size;
    in property <string> architecture;
    in property <bool> loaded: false;
    callback clicked;

    height: 80px;
    border-radius: Theme.radius-lg;
    background: Theme.surface;
    border-width: 1px;
    border-color: root.loaded ? Theme.success : Theme.border-subtle;
    clip: true;

    HorizontalLayout {
        padding: Theme.space-lg;
        spacing: Theme.space-md;
        alignment: space-between;

        VerticalLayout {
            spacing: Theme.space-xs;
            alignment: center;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: Theme.space-sm;
                Text { text: root.name; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                if root.loaded : Rectangle {
                    width: 50px;
                    height: 18px;
                    border-radius: 9px;
                    background: Theme.success;
                    Text { text: "Loaded"; color: #ffffff; font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-lg;
                Text { text: root.architecture; color: Theme.text-muted; font-size: 11px; overflow: elide; }
                Text { text: root.size; color: Theme.text-muted; font-size: 11px; overflow: elide; }
            }
        }
    }

    TouchArea { clicked => { root.clicked(); } }
}

export component ModelsView inherits Rectangle {
    in property <bool> has-local-model: false;
    in property <string> local-model-name: "";
    in property <string> local-model-size: "";
    in property <bool> model-loaded: false;
    in property <int> on-chain-model-count: 0;
    in property <string> model-ipfs-cid: "";
    in property <bool> model-pinning: false;
    // Publish state machine: "local" → "pinned" → "submitted" → "confirmed" → "verified" → "ready" | "failed"
    in property <string> publish-state: "local";

    callback load-model;
    callback deploy-model;
    callback run-inference;
    callback browse-huggingface;
    callback pin-model-to-ipfs;

    background: Theme.bg;

    Flickable {
    VerticalLayout {
        padding-top: Theme.space-lg;
        padding-bottom: Theme.space-lg;
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        spacing: Theme.space-lg;

        Text { text: "Models"; color: Theme.text; font-size: 24px; font-weight: 600; }

        // Local models section
        VerticalLayout {
            spacing: Theme.space-md;

            Text { text: "Local Models"; color: Theme.text-secondary; font-size: 14px; font-weight: 500; }

            if root.has-local-model : ModelCard {
                name: root.local-model-name;
                size: root.local-model-size;
                architecture: "GGUF";
                loaded: root.model-loaded;
                clicked => { root.load-model(); }
            }

            if !root.has-local-model : Rectangle {
                height: 80px;
                border-radius: Theme.radius-lg;
                border-width: 2px;
                border-color: Theme.border;

                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-xs;
                    Text { text: "No local models"; color: Theme.text-muted; font-size: 13px; horizontal-alignment: center; }
                    Text { text: "Download a model from HuggingFace or bundle one with the installer."; color: Theme.text-muted; font-size: 11px; horizontal-alignment: center; }
                }
            }

            // IPFS pinning for local model
            if root.has-local-model : Rectangle {
                min-height: 48px;
                border-radius: Theme.radius-md;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border-subtle;

                HorizontalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-md;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        if root.model-ipfs-cid == "" && !root.model-pinning : Text {
                            text: "Pin model to IPFS for decentralized storage";
                            color: Theme.text-muted; font-size: 11px;
                        }
                        if root.model-pinning : Text {
                            text: "Pinning to IPFS...";
                            color: Theme.accent; font-size: 11px;
                        }
                        if root.model-ipfs-cid != "" : Text {
                            text: "IPFS: " + root.model-ipfs-cid;
                            color: Theme.success; font-size: 11px; overflow: elide;
                        }
                    }

                    if root.model-ipfs-cid == "" : Rectangle {
                        width: 80px; height: 28px;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: pin-btn.has-hover ? Theme.accent : Theme.border;
                        background: pin-btn.pressed ? Theme.bg-secondary :
                                    (pin-btn.has-hover ? Theme.bg-tertiary : transparent);
                        animate background { duration: Theme.duration-fast; easing: ease-in-out; }
                        opacity: root.model-pinning ? 0.5 : 1.0;

                        Text { text: "Pin"; color: Theme.accent; font-size: 11px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
                        pin-btn := TouchArea { mouse-cursor: root.model-pinning ? default : pointer; clicked => { if !root.model-pinning { root.pin-model-to-ipfs(); } } }
                    }
                }
            }
        }

        // Publish workflow section
        if root.has-local-model : VerticalLayout {
            spacing: Theme.space-md;

            Text { text: "Publish to Registry"; color: Theme.text-secondary; font-size: 14px; font-weight: 500; }

            // Publish stepper — shows current state of the publish pipeline
            Rectangle {
                min-height: 80px;
                border-radius: Theme.radius-lg;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border-subtle;

                // Publish state: local → pinned → submitted → confirmed → verified → ready
                // Each step lights up only when the state has genuinely advanced
                property <bool> step-pinned: root.publish-state == "pinned" || root.publish-state == "submitted" || root.publish-state == "confirmed" || root.publish-state == "verified" || root.publish-state == "ready";
                property <bool> step-submitted: root.publish-state == "submitted" || root.publish-state == "confirmed" || root.publish-state == "verified" || root.publish-state == "ready";
                property <bool> step-confirmed: root.publish-state == "confirmed" || root.publish-state == "verified" || root.publish-state == "ready";
                property <bool> step-verified: root.publish-state == "verified" || root.publish-state == "ready";
                property <bool> step-failed: root.publish-state == "failed";

                HorizontalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;

                    // Step 1: Pin
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: Theme.space-xs;
                        Rectangle {
                            width: 24px; height: 24px; border-radius: 12px;
                            background: step-pinned ? Theme.success : Theme.bg-tertiary;
                            Text { text: "1"; color: step-pinned ? #000000 : Theme.text-muted; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "Pin"; color: step-pinned ? Theme.success : Theme.text-muted; font-size: 10px; horizontal-alignment: center; }
                    }

                    Text { text: "->"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }

                    // Step 2: Submit
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: Theme.space-xs;
                        Rectangle {
                            width: 24px; height: 24px; border-radius: 12px;
                            background: step-submitted ? Theme.warning : Theme.bg-tertiary;
                            Text { text: "2"; color: step-submitted ? #000000 : Theme.text-muted; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "Submit"; color: step-submitted ? Theme.warning : Theme.text-muted; font-size: 10px; horizontal-alignment: center; }
                    }

                    Text { text: "->"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }

                    // Step 3: Confirm
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: Theme.space-xs;
                        Rectangle {
                            width: 24px; height: 24px; border-radius: 12px;
                            background: step-confirmed ? Theme.info : Theme.bg-tertiary;
                            Text { text: "3"; color: step-confirmed ? #000000 : Theme.text-muted; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "Confirm"; color: step-confirmed ? Theme.info : Theme.text-muted; font-size: 10px; horizontal-alignment: center; }
                    }

                    Text { text: "->"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }

                    // Step 4: Verify (readback)
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: Theme.space-xs;
                        Rectangle {
                            width: 24px; height: 24px; border-radius: 12px;
                            background: step-verified ? Theme.success : Theme.bg-tertiary;
                            Text { text: "4"; color: step-verified ? #000000 : Theme.text-muted; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "Verify"; color: step-verified ? Theme.success : Theme.text-muted; font-size: 10px; horizontal-alignment: center; }
                    }
                }

                // Failed state banner
                if step-failed : HorizontalLayout {
                    padding-left: Theme.space-md;
                    padding-top: Theme.space-xs;
                    spacing: Theme.space-sm;
                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.error; y: 3px; }
                    Text { text: "Publish failed — check logs"; color: Theme.error; font-size: 11px; }
                }
            }

            // Next action CTA — always shows one clear thing to do
            Rectangle {
                height: 40px;
                border-radius: Theme.radius-md;
                background: root.publish-state == "failed" ? Theme.error
                    : root.publish-state == "verified" || root.publish-state == "ready" ? Theme.success
                    : Theme.accent;

                Text {
                    text: root.publish-state == "local" ? "Pin Model to IPFS"
                        : root.publish-state == "hashed" ? "Pin Model to IPFS"
                        : root.publish-state == "pinned" ? "Register On-Chain"
                        : root.publish-state == "submitted" ? "Awaiting Confirmation..."
                        : root.publish-state == "confirmed" ? "Verifying Registry..."
                        : root.publish-state == "verified" ? "Verified — Model Published"
                        : root.publish-state == "ready" ? "Ready for Inference"
                        : root.publish-state == "failed" ? "Retry Publish"
                        : "Pin Model to IPFS";
                    color: #000000;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    enabled: root.publish-state != "submitted" && root.publish-state != "confirmed";
                    clicked => {
                        if root.publish-state == "local" || root.publish-state == "hashed" {
                            root.pin-model-to-ipfs();
                        } else if root.publish-state == "pinned" || root.publish-state == "failed" {
                            root.deploy-model();
                        }
                    }
                }
            }

            // State detail card (when publish is in progress)
            if root.publish-state != "local" : Rectangle {
                min-height: 40px;
                border-radius: Theme.radius-md;
                background: Theme.bg-tertiary;
                border-width: 1px;
                border-color: Theme.border-subtle;

                HorizontalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-lg;

                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text { text: "State"; color: Theme.text-muted; font-size: 10px; }
                        Text { text: root.publish-state; color: Theme.text; font-size: 12px; font-weight: 600; }
                    }

                    if root.model-ipfs-cid != "" : VerticalLayout {
                        spacing: Theme.space-xs;
                        horizontal-stretch: 1;
                        Text { text: "CID / Tx"; color: Theme.text-muted; font-size: 10px; }
                        Text { text: root.model-ipfs-cid; color: Theme.text-secondary; font-size: 10px; overflow: elide; }
                    }
                }
            }
        }

        // On-chain models section
        VerticalLayout {
            spacing: Theme.space-md;

            HorizontalLayout {
                alignment: space-between;
                Text { text: "On-Chain Registry"; color: Theme.text-secondary; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                Text { text: root.on-chain-model-count + " registered"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
            }

            if root.on-chain-model-count == 0 : Rectangle {
                min-height: 60px;
                border-radius: Theme.radius-lg;
                border-width: 2px;
                border-color: Theme.border;
                background: transparent;

                Text {
                    text: "No models registered on-chain yet. Publish a local model to get started.";
                    color: Theme.text-muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Placeholder for browsable model list (populated from citrate_listModels RPC)
            if root.on-chain-model-count > 0 : Text {
                text: root.on-chain-model-count + " models available. Use Chat to interact with registered models.";
                color: Theme.text-secondary;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        // Actions
        HorizontalLayout {
            spacing: Theme.space-sm;

            Rectangle {
                height: 38px;
                horizontal-stretch: 1;
                border-radius: Theme.radius-md;
                background: hf-btn.pressed ? Theme.accent-hover.darker(0.15) :
                            (hf-btn.has-hover ? Theme.accent-hover : Theme.accent);
                animate background { duration: Theme.duration-fast; easing: ease-in-out; }
                Text { text: "Browse HuggingFace"; color: #000000; font-size: Theme.font-size-sm; font-weight: Theme.font-weight-semibold; horizontal-alignment: center; vertical-alignment: center; }
                hf-btn := TouchArea { mouse-cursor: pointer; clicked => { root.browse-huggingface(); } }
            }

            Rectangle {
                height: 38px;
                horizontal-stretch: 1;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: deploy-btn.has-hover ? Theme.accent : Theme.border;
                background: deploy-btn.pressed ? Theme.bg-secondary :
                            (deploy-btn.has-hover ? Theme.bg-tertiary : transparent);
                animate background { duration: Theme.duration-fast; easing: ease-in-out; }
                animate border-color { duration: Theme.duration-fast; easing: ease-in-out; }
                Text { text: "Deploy Model"; color: Theme.text; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; }
                deploy-btn := TouchArea { mouse-cursor: pointer; clicked => { root.deploy-model(); } }
            }
        }
    }
    }
}
