// Compute — opt-in GPU/CPU sharing with the Citrate compute
// marketplace. The ARCHIVE Tauri GPUSettings.tsx is the visual
// reference; this Slint port keeps the same mental model:
//
//   - big Enable toggle up top (default off)
//   - allocation slider below (disabled until enabled)
//   - schedule picker (Always / Nights / Weekends)
//   - detected-hardware card above the toggle so the user knows
//     exactly what they'd be sharing
//   - Register button at the bottom, disabled with a "coming soon"
//     pill until the contract-registration flow lands
//
// P960-D WP-D.1 / D.2.
import { Theme } from "@citrate-ui-kit";

// CM-01 WP-01.5 — one row of the provider's recent activity.
// Populated from ComputeMarketplace event logs (JobAssigned,
// JobCompleted, JobFailed) via marketplace_client::fetch_recent_activity.
export struct ListingActivityRow {
    job-id: int,
    block-number: int,
    status: string,   // "Assigned" | "Completed" | "Failed"
}

export component ComputeView inherits Rectangle {
    // Detected hardware — populated by the Rust side on tab open.
    in property <string> hw-summary: "Detecting hardware…";
    in property <string> hw-cpu: "—";
    in property <int>    hw-cpu-cores: 0;
    in property <int>    hw-cpu-threads: 0;
    in property <int>    hw-ram-gb: 0;
    in property <bool>   hw-has-gpu: false;
    in property <string> hw-gpu-name: "";
    in property <int>    hw-gpu-vram-gb: 0;
    in property <string> hw-gpu-cc: "";
    in property <string> hw-gpu-driver: "";

    // User-settable compute prefs (persisted to compute.json)
    in-out property <bool>   enabled: false;
    in-out property <int>    allocation-percent: 50;
    in-out property <string> schedule: "always";
    in property <string> schedule-description: "Share compute 24/7";

    // GUI-RELAY-S1: auto-sign the node-agent's won-job writes while unlocked.
    in-out property <bool>   relay-enabled: false;

    // Marketplace status (existing contract scaffolding)
    in property <int>    active-jobs: 0;
    in property <int>    available-providers: 0;
    in property <string> provider-status: "Not registered";
    in property <string> total-compute-earned: "0";
    in property <string> contract-status: "unknown";
    // Real isRegistered flag from ComputeMarketplace.getProvider().
    // Drives button text/color flip — "List on marketplace" → "✓ Listed".
    in property <bool> is-registered: false;

    // CM-01 listing card — structured view of the provider's listing.
    // All fields populated from ComputeMarketplace.getProvider() +
    // ContributionAccounting.claimable() on the background poll.
    // SALT display values pass through grains_to_salt before arrival —
    // never raw grains. See listing_visibility.feature scenarios.
    in property <string> listing-stake: "0";        // "1000" (SALT)
    in property <string> listing-reputation-pct: "0.0";  // "98.5"
    in property <string> listing-capacity: "0 / 0"; // "0 / 10"
    in property <string> listing-models: "—";      // "any (wildcard)"
    in property <string> listing-claimable: "0";    // "1.5" (SALT)
    in property <int>    listing-total-completed: 0;
    in property <int>    listing-total-failed: 0;
    in property <bool>   listing-connection-ok: true;

    // CM-01 WP-01.5 — recent activity list.
    // Up to 10 rows, newest first, from eth_getLogs on
    // ComputeMarketplace's JobAssigned / JobCompleted / JobFailed events.
    // Empty list → friendly empty-state ("No jobs yet…").
    in property <[ListingActivityRow]> listing-activity: [];

    // Callbacks
    callback settings-changed;   // emitted after enabled / allocation / schedule change
    callback relay-toggled;      // emitted after the auto-sign relay toggle flips (GUI-RELAY-S1)
    callback register-provider;  // fires ComputeMarketplace.registerProvider (P960-D WP-D.3)
    callback claim-earnings;     // fires ContributionAccounting.claimRewards (P960-D WP-D.4)
    callback refresh;
    callback refresh-listing;    // CM-01: manual bypass of 30s poll cadence

    background: Theme.bg;

    Flickable {
        VerticalLayout {
            padding: Theme.space-lg;
            spacing: Theme.space-lg;

            // ── Header ─────────────────────────────────────────────
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Compute";
                    color: Theme.text;
                    font-family: Theme.font-display;
                    font-size: 24px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 80px; height: 30px;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border;
                    Text { text: "Refresh"; color: Theme.text-secondary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.refresh(); } }
                }
            }

            // ── Detected hardware card ─────────────────────────────
            // Always visible so users can see exactly what compute
            // they'd contribute before deciding to opt in.
            Rectangle {
                border-radius: Theme.radius-lg;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border-subtle;
                min-height: 120px;

                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        Text { text: "🖥"; font-size: 18px; vertical-alignment: center; }
                        Text {
                            text: "Your machine";
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }

                    // GPU detail, or a friendly "no GPU detected" line
                    if root.hw-has-gpu : VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            Text { text: "GPU"; color: Theme.text-muted; font-size: 11px; min-width: 88px; }
                            Text { text: root.hw-gpu-name + "  ·  " + root.hw-gpu-vram-gb + " GB VRAM"; color: Theme.text; font-size: 12px; }
                        }
                        HorizontalLayout {
                            Text { text: "CUDA"; color: Theme.text-muted; font-size: 11px; min-width: 88px; }
                            Text {
                                text: "compute capability " + root.hw-gpu-cc + "  ·  driver " + root.hw-gpu-driver;
                                color: Theme.text-muted;
                                font-size: 11px;
                            }
                        }
                    }
                    if !root.hw-has-gpu : Text {
                        text: "No NVIDIA GPU detected. CPU-only sharing is still supported but earns less.";
                        color: Theme.text-muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        Text { text: "CPU"; color: Theme.text-muted; font-size: 11px; min-width: 88px; }
                        Text { text: root.hw-cpu + "  ·  " + root.hw-cpu-cores + " cores / " + root.hw-cpu-threads + " threads"; color: Theme.text; font-size: 12px; overflow: elide; }
                    }
                    HorizontalLayout {
                        Text { text: "Memory"; color: Theme.text-muted; font-size: 11px; min-width: 88px; }
                        Text { text: root.hw-ram-gb + " GB"; color: Theme.text; font-size: 12px; }
                    }
                }
            }

            // ── Opt-in toggle ──────────────────────────────────────
            Rectangle {
                border-radius: Theme.radius-lg;
                background: Theme.surface;
                border-width: 1px;
                border-color: root.enabled ? Theme.accent : Theme.border-subtle;
                animate border-color { duration: Theme.duration-fast; }

                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: "Enable compute sharing"; color: Theme.text; font-size: 14px; font-weight: 600; }
                            Text {
                                text: "Earn SALT by running compute jobs from the marketplace. Off by default — no data leaves your machine until you turn this on.";
                                color: Theme.text-muted;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }

                        // iOS-style switch
                        Rectangle {
                            width: 44px; height: 24px;
                            border-radius: 12px;
                            background: root.enabled ? Theme.accent : Theme.border;
                            animate background { duration: Theme.duration-fast; }
                            y: 8px;

                            Rectangle {
                                width: 20px; height: 20px;
                                border-radius: 10px;
                                background: Theme.knob;
                                y: 2px;
                                x: root.enabled ? 22px : 2px;
                                animate x { duration: Theme.duration-fast; easing: ease-in-out; }
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.enabled = !root.enabled;
                                    root.settings-changed();
                                }
                            }
                        }
                    }

                    // ── Auto-sign relay toggle (GUI-RELAY-S1) ──────────
                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: "Auto-sign won jobs"; color: Theme.text; font-size: 14px; font-weight: 600; }
                            Text {
                                text: "Settle the node-agent's won jobs on-chain automatically: this wallet signs each validated job write while it is unlocked. Off by default.";
                                color: Theme.text-muted;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }

                        // iOS-style switch
                        Rectangle {
                            width: 44px; height: 24px;
                            border-radius: 12px;
                            background: root.relay-enabled ? Theme.accent : Theme.border;
                            animate background { duration: Theme.duration-fast; }
                            y: 8px;

                            Rectangle {
                                width: 20px; height: 20px;
                                border-radius: 10px;
                                background: Theme.knob;
                                y: 2px;
                                x: root.relay-enabled ? 22px : 2px;
                                animate x { duration: Theme.duration-fast; easing: ease-in-out; }
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.relay-enabled = !root.relay-enabled;
                                    root.relay-toggled();
                                }
                            }
                        }
                    }

                    // ── Allocation slider (disabled until enabled) ─────
                    Rectangle {
                        height: 64px;
                        opacity: root.enabled ? 1.0 : 0.4;

                        VerticalLayout {
                            spacing: Theme.space-sm;

                            HorizontalLayout {
                                Text { text: "⚡"; font-size: 13px; vertical-alignment: center; }
                                Text { text: "Allocation"; color: Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: root.allocation-percent + "%"; color: Theme.accent; font-size: 13px; font-weight: 700; }
                            }

                            // Custom slider — Slint's built-in Slider
                            // gives acceptable behavior on software renderer;
                            // keep it simple.
                            Rectangle {
                                height: 24px;

                                // Track
                                Rectangle {
                                    height: 6px;
                                    y: 9px;
                                    border-radius: 3px;
                                    background: Theme.bg-tertiary;

                                    // Fill
                                    Rectangle {
                                        x: 0;
                                        y: 0;
                                        width: parent.width * (root.allocation-percent / 100);
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Theme.accent;
                                        animate width { duration: Theme.duration-fast; }
                                    }
                                }

                                // Thumb — click anywhere on the row to set %
                                slider-area := TouchArea {
                                    enabled: root.enabled;
                                    mouse-cursor: root.enabled ? pointer : default;
                                    clicked => {
                                        // Clamp to 0..100 step 5
                                        if (root.enabled) {
                                            // TouchArea.mouse-x is relative to the touch area
                                            if (self.width > 0) {
                                                // Compute raw percent, snap to step 5
                                                root.allocation-percent = Math.round(
                                                    (self.mouse-x / self.width) * 100 / 5
                                                ) * 5;
                                                if (root.allocation-percent < 0) { root.allocation-percent = 0; }
                                                if (root.allocation-percent > 100) { root.allocation-percent = 100; }
                                                root.settings-changed();
                                            }
                                        }
                                    }
                                }

                                // Thumb visual — sits on top, positioned to allocation
                                Rectangle {
                                    width: 16px; height: 16px;
                                    y: 4px;
                                    x: parent.width * (root.allocation-percent / 100) - 8px;
                                    border-radius: 8px;
                                    background: root.enabled ? Theme.knob : Theme.text-muted;
                                    border-width: 2px;
                                    border-color: Theme.accent;
                                    animate x { duration: Theme.duration-fast; }
                                }
                            }
                        }
                    }

                    // ── Schedule picker ────────────────────────────
                    Rectangle {
                        height: 78px;
                        opacity: root.enabled ? 1.0 : 0.4;

                        VerticalLayout {
                            spacing: Theme.space-sm;

                            HorizontalLayout {
                                Text { text: "🕐"; font-size: 13px; vertical-alignment: center; }
                                Text { text: "Schedule"; color: Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                            }

                            HorizontalLayout {
                                spacing: Theme.space-sm;

                                for s[idx] in ["always", "nights", "weekends"] : Rectangle {
                                    height: 32px;
                                    horizontal-stretch: 1;
                                    border-radius: Theme.radius-md;
                                    background: root.schedule == s ? Theme.accent : Theme.bg-tertiary;
                                    border-width: 1px;
                                    border-color: root.schedule == s ? Theme.accent : Theme.border-subtle;
                                    animate background { duration: Theme.duration-fast; }
                                    animate border-color { duration: Theme.duration-fast; }

                                    Text {
                                        text: s == "always" ? "Always"
                                            : s == "nights" ? "Nights"
                                            : "Weekends";
                                        color: root.schedule == s ? Theme.on-accent : Theme.text-secondary;
                                        font-size: 11px;
                                        font-weight: root.schedule == s ? 700 : 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        enabled: root.enabled;
                                        mouse-cursor: root.enabled ? pointer : default;
                                        clicked => {
                                            if (root.enabled) {
                                                root.schedule = s;
                                                root.settings-changed();
                                            }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: root.schedule-description;
                                color: Theme.text-muted;
                                font-size: 11px;
                            }
                        }
                    }
                }
            }

            // ── Marketplace status + registration ──────────────────
            Rectangle {
                border-radius: Theme.radius-lg;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border-subtle;
                min-height: 120px;

                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        Text {
                            text: "Marketplace";
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                        }
                        // Contract status pill — green when the marketplace
                        // is deployed on the active chain, amber otherwise.
                        Rectangle {
                            width: 110px; height: 22px;
                            border-radius: 11px;
                            background: root.contract-status == "Marketplace live"
                                ? Theme.success-bg
                                : Theme.warning-bg;
                            border-width: root.contract-status == "Marketplace live" ? 0 : 1px;
                            border-color: Theme.warning;
                            Text {
                                text: root.contract-status == "Marketplace live"
                                    ? "● live"
                                    : "● offline";
                                color: root.contract-status == "Marketplace live"
                                    ? Theme.success-text : Theme.warning-text;
                                font-size: 10px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-lg;

                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "ACTIVE JOBS"; color: Theme.text-muted; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; }
                            Text { text: root.active-jobs; color: Theme.accent; font-size: 18px; font-weight: 700; }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "PROVIDERS"; color: Theme.text-muted; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; }
                            Text { text: root.available-providers; color: Theme.info; font-size: 18px; font-weight: 700; }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: "YOUR EARNINGS"; color: Theme.text-muted; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; }
                            Text { text: root.total-compute-earned + " SALT"; color: Theme.success; font-size: 18px; font-weight: 700; overflow: elide; }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-sm;

                        Text {
                            text: "Status: " + root.provider-status;
                            color: Theme.text-muted;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        // Register — live when the marketplace is deployed on
                        // this network. Label flips to "✓ Listed" once
                        // getProvider().isRegistered is true, so operators
                        // know they're already on the marketplace.
                        Rectangle {
                            width: 180px; height: 32px;
                            border-radius: Theme.radius-md;
                            background: root.contract-status != "Marketplace live"
                                ? Theme.bg-tertiary
                                : (root.is-registered
                                    ? Theme.success.darker(0.2)
                                    : (reg-ta.has-hover ? Theme.accent-hover : Theme.accent));
                            border-width: 1px;
                            border-color: root.is-registered
                                ? Theme.success : Theme.border;
                            opacity: root.contract-status == "Marketplace live" ? 1.0 : 0.55;
                            animate background { duration: 120ms; }

                            Text {
                                text: root.is-registered
                                    ? "✓ Listed on marketplace"
                                    : "List on marketplace (1000 SALT)";
                                color: root.contract-status != "Marketplace live"
                                    ? Theme.text-muted
                                    : (root.is-registered
                                        ? Theme.text : Theme.on-accent);
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            reg-ta := TouchArea {
                                mouse-cursor: pointer;
                                enabled: root.contract-status == "Marketplace live"
                                    && !root.is-registered;
                                clicked => { root.register-provider(); }
                            }
                        }

                        // Claim earnings — visible only when there's
                        // actually something to claim (total-compute-earned > "0")
                        Rectangle {
                            width: 130px; height: 32px;
                            border-radius: Theme.radius-md;
                            background: claim-ta.has-hover ? Theme.success.darker(0.2) : Theme.success.darker(0.4);
                            border-width: 1px;
                            border-color: Theme.border;
                            visible: root.total-compute-earned != "0";
                            animate background { duration: 120ms; }

                            Text {
                                text: "Claim " + root.total-compute-earned + " SALT";
                                color: Theme.text;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            claim-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.claim-earnings(); }
                            }
                        }
                    }

                    // ── CM-01: Your listing card ────────────────────
                    // Visible only when the provider is registered on-chain.
                    // Structured counterpart to the single-line status
                    // above. Feature spec:
                    // citrate_v0.01.1/specs/gherkin/listing_visibility.feature
                    if root.is-registered : Rectangle {
                        border-radius: Theme.radius-lg;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        background: Theme.bg-secondary;

                        VerticalLayout {
                            padding: Theme.space-md;
                            spacing: Theme.space-sm;

                            // Header row: title + connection indicator + refresh
                            HorizontalLayout {
                                spacing: Theme.space-sm;
                                alignment: space-between;

                                Text {
                                    text: "YOUR LISTING";
                                    color: Theme.text-muted;
                                    font-size: 10px;
                                    font-weight: 600;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }

                                // Connection indicator — shown only when
                                // the RPC is unreachable so the user knows
                                // values may be stale.
                                if !root.listing-connection-ok : Rectangle {
                                    width: 110px; height: 20px;
                                    border-radius: 10px;
                                    background: Theme.warning-bg;
                                    border-width: 1px;
                                    border-color: Theme.warning;
                                    Text {
                                        text: "● connection lost";
                                        color: Theme.warning;
                                        font-size: 9px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Refresh — triggers immediate poll,
                                // bypassing the 30 s background cadence.
                                Rectangle {
                                    width: 70px; height: 24px;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: refresh-ta.has-hover
                                        ? Theme.bg-tertiary : transparent;
                                    animate background { duration: 120ms; }
                                    Text {
                                        text: "↻ Refresh";
                                        color: Theme.text-secondary;
                                        font-size: 10px;
                                        font-weight: 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    refresh-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.refresh-listing(); }
                                    }
                                }
                            }

                            // Fields grid: 2 columns × 2 rows
                            // Row 1: Stake | Reputation
                            HorizontalLayout {
                                spacing: Theme.space-lg;
                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "STAKE";
                                        color: Theme.text-muted;
                                        font-size: 9px;
                                        font-weight: 600;
                                        letter-spacing: 0.3px;
                                    }
                                    Text {
                                        text: root.listing-stake + " SALT";
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 600;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "REPUTATION";
                                        color: Theme.text-muted;
                                        font-size: 9px;
                                        font-weight: 600;
                                        letter-spacing: 0.3px;
                                    }
                                    Text {
                                        text: root.listing-reputation-pct + "%";
                                        color: Theme.success;
                                        font-size: 15px;
                                        font-weight: 600;
                                    }
                                }
                            }

                            // Row 2: Capacity | Models
                            HorizontalLayout {
                                spacing: Theme.space-lg;
                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "CAPACITY";
                                        color: Theme.text-muted;
                                        font-size: 9px;
                                        font-weight: 600;
                                        letter-spacing: 0.3px;
                                    }
                                    Text {
                                        text: root.listing-capacity + " active jobs";
                                        color: Theme.text;
                                        font-size: 13px;
                                        font-weight: 500;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "MODELS";
                                        color: Theme.text-muted;
                                        font-size: 9px;
                                        font-weight: 600;
                                        letter-spacing: 0.3px;
                                    }
                                    Text {
                                        text: root.listing-models;
                                        color: Theme.text;
                                        font-size: 13px;
                                        font-weight: 500;
                                        overflow: elide;
                                    }
                                }
                            }

                            // Row 3: Job history aggregate
                            HorizontalLayout {
                                spacing: Theme.space-lg;
                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "JOBS COMPLETED / FAILED";
                                        color: Theme.text-muted;
                                        font-size: 9px;
                                        font-weight: 600;
                                        letter-spacing: 0.3px;
                                    }
                                    Text {
                                        text: root.listing-total-completed + " / " + root.listing-total-failed;
                                        color: Theme.text;
                                        font-size: 13px;
                                        font-weight: 500;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "CLAIMABLE";
                                        color: Theme.text-muted;
                                        font-size: 9px;
                                        font-weight: 600;
                                        letter-spacing: 0.3px;
                                    }
                                    Text {
                                        text: root.listing-claimable + " SALT";
                                        color: root.listing-claimable == "0"
                                            ? Theme.text-muted : Theme.success;
                                        font-size: 13px;
                                        font-weight: 500;
                                    }
                                }
                            }

                            // ── Recent activity ─────────────────────
                            Rectangle {
                                height: 1px;
                                background: Theme.border-subtle;
                            }
                            Text {
                                text: "RECENT ACTIVITY";
                                color: Theme.text-muted;
                                font-size: 9px;
                                font-weight: 600;
                                letter-spacing: 0.3px;
                            }
                            if root.listing-activity.length == 0 : Text {
                                text: "No jobs yet — waiting for first assignment";
                                color: Theme.text-muted;
                                font-size: 11px;
                            }
                            for row in root.listing-activity : HorizontalLayout {
                                spacing: Theme.space-md;
                                padding-top: 2px;
                                padding-bottom: 2px;
                                Text {
                                    text: "#" + row.job-id;
                                    color: Theme.text;
                                    font-size: 11px;
                                    font-family: Theme.font-mono;
                                    min-width: 60px;
                                }
                                Text {
                                    text: "block " + row.block-number;
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: row.status;
                                    color: row.status == "Completed"
                                        ? Theme.success
                                        : (row.status == "Failed"
                                            ? Theme.error
                                            : Theme.accent);
                                    font-size: 11px;
                                    font-weight: 600;
                                    min-width: 80px;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }

                    // Deploy-status banner — shown when the ComputeMarketplace
                    // isn't deployed on the active network. Keeps the user
                    // honest about what surface is real today.
                    if root.contract-status != "Marketplace live" : Rectangle {
                        height: 48px;
                        border-radius: Theme.radius-md;
                        // Warning-tinted bg (mode-aware token)
                        background: Theme.warning-bg;
                        border-width: 1px;
                        border-color: Theme.warning;

                        HorizontalLayout {
                            padding: Theme.space-sm;
                            spacing: Theme.space-sm;
                            alignment: start;
                            Text {
                                text: "⚠";
                                color: Theme.warning;
                                font-size: 18px;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: root.contract-status;
                                    color: Theme.text;
                                    font-size: 11px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "Your opt-in preferences are saved locally and will activate once the marketplace is live on this network.";
                                    color: Theme.text-secondary;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
