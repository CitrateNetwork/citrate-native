// Dashboard — stat cards + wallet summary + recent blocks
import { Theme } from "@citrate-ui-kit";

component StatCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> ok: true;
    in property <color> accent-color: Theme.success;

    min-height: 88px;
    border-radius: Theme.radius-lg;
    background: touch.has-hover ? Theme.bg-tertiary.brighter(0.3) : Theme.surface;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border : Theme.border-subtle;
    clip: true;
    animate background { duration: Theme.duration-fast; easing: ease-in-out; }
    animate border-color { duration: Theme.duration-fast; easing: ease-in-out; }
    // Subtle depth — lifts card off the background on hover
    drop-shadow-offset-y: touch.has-hover ? 2px : 0px;
    drop-shadow-blur: touch.has-hover ? 8px : 0px;
    drop-shadow-color: touch.has-hover ? Theme.shadow-color-sm : transparent;

    touch := TouchArea {}

    VerticalLayout {
        padding: Theme.space-lg;
        spacing: Theme.space-sm;

        HorizontalLayout {
            alignment: space-between;
            Text { text: root.label; color: Theme.text-muted; font-size: 11px; font-weight: 500; letter-spacing: 0.5px; }
            Rectangle {
                width: 8px; height: 8px; border-radius: 4px;
                background: root.ok ? root.accent-color : Theme.text-muted;
            }
        }

        Text {
            text: root.value;
            color: Theme.text;
            font-family: Theme.font-display;
            font-size: 22px;
            font-weight: 600;
            overflow: elide;
        }
    }
}

component BlockRow inherits Rectangle {
    in property <string> height-text;
    in property <string> tx-count;
    in property <string> time-text;
    in property <string> hash-text;
    // T2-15: short proposer pubkey (first 8 hex chars of ed25519 key)
    // in monospace so operators recognize their own blocks.
    in property <string> proposer-short;

    height: 36px;

    HorizontalLayout {
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        spacing: Theme.space-xl;

        Text { text: root.height-text; color: Theme.text; font-size: 12px; font-weight: 600; min-width: 80px; vertical-alignment: center; }
        Text { text: root.tx-count; color: Theme.text-muted; font-size: 12px; min-width: 60px; vertical-alignment: center; }
        Text { text: root.time-text; color: Theme.text-muted; font-size: 12px; min-width: 80px; vertical-alignment: center; }
        Text { text: root.hash-text; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text {
            text: root.proposer-short;
            color: Theme.success;
            font-size: 11px;
            font-family: Theme.font-mono;
            vertical-alignment: center;
            min-width: 80px;
            overflow: elide;
        }
    }
}

export component Dashboard inherits Rectangle {
    in property <bool> node-running: false;
    in property <int> block-height: 0;
    in property <int> peer-count: 0;
    in property <int> mempool-size: 0;
    in property <string> balance: "0";
    in property <string> earned: "0.0000";
    // Recent block data (pushed from Rust background thread — real RocksDB reads)
    in property <string> block-hash-0: "";
    in property <string> block-hash-1: "";
    in property <string> block-hash-2: "";
    in property <string> block-txcount-0: "0 txns";
    in property <string> block-txcount-1: "0 txns";
    in property <string> block-txcount-2: "0 txns";
    in property <string> block-time-0: "";
    in property <string> block-time-1: "";
    in property <string> block-time-2: "";
    // T2-15: proposer short-hex (first 8 chars of ed25519 pubkey)
    in property <string> block-proposer-0: "";
    in property <string> block-proposer-1: "";
    in property <string> block-proposer-2: "";
    // T2-16: claimable balance from ContributionAccounting, separate
    // from `earned` (which is block-reward delta vs baseline).
    in property <string> claimable-contributions: "0";

    background: Theme.bg;

    Flickable {
        VerticalLayout {
            padding-top: Theme.space-lg;
            padding-bottom: Theme.space-lg;
            padding-left: Theme.space-lg;
            padding-right: Theme.space-lg;
            spacing: Theme.space-lg;

                Text {
                    text: "Dashboard";
                    color: Theme.text;
                    font-family: Theme.font-display;
                    font-size: 24px;
                    font-weight: 600;
                }

                // Stat cards — 3 top, 2 bottom
                VerticalLayout {
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        StatCard { label: "NODE STATUS"; value: root.node-running ? "Running" : "Stopped"; ok: root.node-running; accent-color: Theme.success; horizontal-stretch: 1; }
                        StatCard { label: "BLOCK HEIGHT"; value: root.block-height > 0 ? root.block-height : "--"; accent-color: Theme.info; horizontal-stretch: 1; }
                        StatCard { label: "PEERS"; value: root.peer-count; ok: root.peer-count > 0; accent-color: Theme.info; horizontal-stretch: 1; }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        StatCard { label: "MEMPOOL"; value: root.mempool-size + " txns"; accent-color: Theme.accent-deep; horizontal-stretch: 1; }
                        StatCard { label: "NETWORK"; value: root.peer-count > 0 ? "Connected" : "Offline"; ok: root.peer-count > 0; accent-color: Theme.warning; horizontal-stretch: 1; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                // Balance + earnings side-by-side so users can see
                // validation rewards accumulating alongside their
                // current balance. `earned` is the delta from the
                // baseline captured at wallet unlock (session total).
                HorizontalLayout {
                    spacing: Theme.space-md;

                    Rectangle {
                        border-radius: Theme.radius-lg;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        min-height: 80px;
                        horizontal-stretch: 2;
                        clip: true;

                        VerticalLayout {
                            padding: Theme.space-xl;
                            spacing: Theme.space-sm;

                            Text { text: "TOTAL BALANCE"; color: Theme.text-muted; font-size: 11px; font-weight: 500; letter-spacing: 0.5px; }
                            Text { text: root.balance + " SALT"; color: Theme.text; font-size: 32px; font-weight: 600; overflow: elide; }
                        }
                    }

                    Rectangle {
                        border-radius: Theme.radius-lg;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        min-height: 80px;
                        horizontal-stretch: 1;
                        clip: true;

                        VerticalLayout {
                            padding: Theme.space-xl;
                            spacing: Theme.space-sm;

                            Text { text: "EARNED THIS SESSION"; color: Theme.text-muted; font-size: 11px; font-weight: 500; letter-spacing: 0.5px; }
                            Text {
                                // Show + prefix when we've earned anything (> 0).
                                // Parse-free check: any non-zero + non-"0.0000" is a delta.
                                text: (root.earned != "0" && root.earned != "0.0000" ? "+" : "") + root.earned + " SALT";
                                color: root.earned != "0" && root.earned != "0.0000" ? Theme.warning : Theme.text-muted;
                                font-family: Theme.font-display;
                                font-size: 24px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: "block rewards (balance delta since session start)";
                                color: Theme.text-muted; font-size: 9px;
                            }
                            // T2-16: claimable breakdown row — earnings
                            // that live in ContributionAccounting (compute
                            // + learning combined). Separate from "earned
                            // this session" because it's post-distribution
                            // balance, not delta.
                            if root.claimable-contributions != "0" : HorizontalLayout {
                                spacing: Theme.space-sm;
                                Text {
                                    text: "+ " + root.claimable-contributions + " SALT claimable";
                                    color: Theme.success;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "(ContributionAccounting — claim in Compute or Learning)";
                                    color: Theme.text-muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Recent blocks
                VerticalLayout {
                    spacing: Theme.space-md;

                    Text { text: "Recent Blocks"; color: Theme.text; font-family: Theme.font-display; font-size: 16px; font-weight: 500; }

                    Rectangle {
                        border-radius: Theme.radius-lg;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        min-height: 60px;
                        vertical-stretch: 1;
                        clip: true;

                        if !root.node-running : Text {
                            text: "Start node to see blocks";
                            color: Theme.text-muted; font-size: 13px;
                            horizontal-alignment: center; vertical-alignment: center;
                        }

                        if root.node-running && root.block-height == 0 : Text {
                            text: "Waiting for blocks...";
                            color: Theme.text-muted; font-size: 13px;
                            horizontal-alignment: center; vertical-alignment: center;
                        }

                        if root.node-running && root.block-height > 0 : VerticalLayout {
                            padding: Theme.space-md;

                            HorizontalLayout {
                                padding-left: Theme.space-lg;
                                padding-right: Theme.space-lg;
                                spacing: Theme.space-xl;
                                height: 28px;

                                Text { text: "Height"; color: Theme.text-muted; font-size: 11px; font-weight: 500; min-width: 80px; vertical-alignment: center; }
                                Text { text: "Txns"; color: Theme.text-muted; font-size: 11px; font-weight: 500; min-width: 60px; vertical-alignment: center; }
                                Text { text: "Time"; color: Theme.text-muted; font-size: 11px; font-weight: 500; min-width: 80px; vertical-alignment: center; }
                                Text { text: "Hash"; color: Theme.text-muted; font-size: 11px; font-weight: 500; vertical-alignment: center; }
                            }

                            BlockRow { height-text: "#" + (root.block-height); tx-count: root.block-txcount-0; time-text: root.block-time-0 != "" ? root.block-time-0 : "just now"; hash-text: root.block-hash-0 != "" ? root.block-hash-0 : "syncing..."; proposer-short: root.block-proposer-0; }
                            if root.block-height > 1 : BlockRow { height-text: "#" + (root.block-height - 1); tx-count: root.block-txcount-1; time-text: root.block-time-1 != "" ? root.block-time-1 : ""; hash-text: root.block-hash-1; proposer-short: root.block-proposer-1; }
                            if root.block-height > 2 : BlockRow { height-text: "#" + (root.block-height - 2); tx-count: root.block-txcount-2; time-text: root.block-time-2 != "" ? root.block-time-2 : ""; hash-text: root.block-hash-2; proposer-short: root.block-proposer-2; }
                        }
                    }
                }
            }
        }
    }
