// DAG Explorer — block list + block detail + search
import { Theme } from "@citrate-ui-kit";

export struct BlockData {
    hash: string,
    height: int,
    timestamp: string,
    tx-count: int,
    selected-parent: string,
    blue-score: int,
    proposer: string,
}

// BFR-INT-5b: per-tx row in the block-detail tx list.
// `tx-hash` is the full hex hash; `hash-short` is the elided form
// (e.g. `0xabcd…1234`). `method-label` is the decoded selector name
// (or "Transfer" for value-only txs, or "0xdeadbeef (unknown)" for
// unmatched selectors). `status` is `confirmed` / `failed` /
// `receipt-missing`; the row colors the status pill accordingly.
export struct TxRowData {
    tx-hash: string,
    hash-short: string,
    method-label: string,
    value-display: string,
    status: string,
}

// T2-13: lightweight DAG viz data — Rust-computed normalized x/y
// in [0, 1] based on recent block height + blue_score, plus flags
// for rendering (is tip? is selected parent chain?).
export struct DagDotData {
    height: int,
    hash-short: string,
    x: float,         // 0..1 (left = oldest in window, right = tip)
    y: float,         // 0..1 (0 = lowest blue score, 1 = highest)
    tx-count: int,
    is-tip: bool,
}

// T2-13: DAG mini-viz — scatter of the last N blocks plotted by
// (normalized height, normalized blue score). Uses Rectangle dots
// positioned absolutely inside a plot area. Parent-edges are a
// deliberate follow-up (Slint Path composition is non-trivial and
// the scatter already conveys "the DAG has a shape" that a flat
// list doesn't).
component DagMiniViz inherits Rectangle {
    in property <[DagDotData]> dots: [];
    in property <int> window-size: 30;  // informational, for the caption

    border-radius: Theme.radius-lg;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border-subtle;

    // Caption
    Text {
        x: Theme.space-md;
        y: Theme.space-sm;
        text: "Last " + root.window-size + " blocks  ·  x = height  ·  y = blue score";
        color: Theme.text-muted;
        font-size: 10px;
        font-family: Theme.font-mono;
    }

    // Plot area — leaves ~24px of padding inside. Dots are
    // positioned at (x * plot_w, (1-y) * plot_h) so y=1 (high blue
    // score) is at the top.
    Rectangle {
        x: 24px;
        y: 32px;
        width: parent.width - 48px;
        height: parent.height - 48px;

        // Axis baseline (x axis)
        Rectangle {
            x: 0;
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: Theme.border-subtle;
        }

        // Dots
        for dot in root.dots : Rectangle {
            x: dot.x * (parent.width - 10px);
            y: (1 - dot.y) * (parent.height - 10px);
            width: dot.is-tip ? 12px : 8px;
            height: dot.is-tip ? 12px : 8px;
            border-radius: 6px;
            background: dot.is-tip ? Theme.accent : Theme.periwinkle;
            border-width: dot.is-tip ? 2px : 0;
            border-color: Theme.accent-hover;
        }
    }

    // Empty state
    if root.dots.length == 0 : Text {
        x: 0; y: 0; width: parent.width; height: parent.height;
        text: "Waiting for blocks…";
        color: Theme.text-muted;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component BlockListRow inherits Rectangle {
    in property <int> height-val;
    in property <string> hash-short;
    in property <string> time-text;
    in property <int> tx-count;
    in property <bool> selected: false;
    callback clicked;

    height: 36px;
    background: selected ? Theme.bg-tertiary : transparent;

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-lg;

        Text { text: "#" + root.height-val; color: Theme.text; font-size: 12px; font-weight: 600; min-width: 80px; vertical-alignment: center; }
        Text { text: root.hash-short; color: Theme.text-muted; font-size: 12px; min-width: 100px; vertical-alignment: center; overflow: elide; }
        Text { text: root.tx-count + " txns"; color: Theme.text-muted; font-size: 12px; min-width: 60px; vertical-alignment: center; }
        Text { text: root.time-text; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
    }

    TouchArea { clicked => { root.clicked(); } }
}

// BFR-INT-5b: clickable tx-list row inside the block detail view.
component TxListRow inherits Rectangle {
    in property <TxRowData> data;
    callback clicked;

    height: 36px;
    border-radius: Theme.radius-sm;
    background: tx-touch.has-hover ? Theme.bg-tertiary.brighter(0.2) : transparent;
    animate background { duration: Theme.duration-fast; }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-md;

        Text {
            text: root.data.hash-short;
            color: Theme.text;
            font-size: 12px;
            font-family: Theme.font-mono;
            min-width: 140px;
            vertical-alignment: center;
        }
        Text {
            text: root.data.method-label;
            color: Theme.accent;
            font-size: 12px;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.data.value-display;
            color: Theme.text-muted;
            font-size: 12px;
            min-width: 100px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        // Status pill
        Rectangle {
            width: 80px;
            height: 22px;
            border-radius: Theme.radius-full;
            background:
                root.data.status == "confirmed" ? Theme.success.with-alpha(0.18) :
                root.data.status == "failed"    ? Theme.error.with-alpha(0.18)   :
                                                  Theme.warning.with-alpha(0.18);
            border-width: 1px;
            border-color:
                root.data.status == "confirmed" ? Theme.success :
                root.data.status == "failed"    ? Theme.error   :
                                                  Theme.warning;
            Text {
                text: root.data.status;
                color:
                    root.data.status == "confirmed" ? Theme.success :
                    root.data.status == "failed"    ? Theme.error   :
                                                      Theme.warning;
                font-size: 10px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    tx-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// BFR-INT-5b: right-edge drawer with full tx detail. Composed inline
// because citrate-native has no shared modal kit primitive.
// Width matches the kit's standard drawer geometry used in
// citrate-boeing-shell's RowDetailDrawer.
export component TransactionModal inherits Rectangle {
    in property <bool> visible-prop: false;
    in property <string> tx-hash: "";
    in property <string> status: "";
    in property <string> from-addr: "";
    in property <string> to-addr: "";
    in property <string> value-display: "";
    in property <string> nonce-display: "";
    in property <string> gas-used-display: "";
    in property <string> gas-price-display: "";
    in property <string> method-label: "";
    in property <string> input-hex: "";
    in property <int> block-height: 0;

    callback close-modal;
    callback copy-text(string);

    visible: root.visible-prop;
    background: rgba(0, 0, 0, 0.55);
    width: 100%;
    height: 100%;

    // Scrim — clicking off-drawer closes the modal
    TouchArea {
        clicked => { root.close-modal(); }
    }

    // Drawer panel
    Rectangle {
        x: parent.width - self.width;
        width: 520px;
        height: parent.height;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border-subtle;

        // Catch clicks inside the drawer so they don't dismiss
        TouchArea { }

        VerticalLayout {
            padding: Theme.space-lg;
            spacing: Theme.space-md;

            // Header
            HorizontalLayout {
                Text {
                    text: "Transaction";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 600;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 32px; height: 32px;
                    border-radius: Theme.radius-md;
                    background: close-touch.has-hover ? Theme.bg-tertiary : transparent;
                    Text {
                        text: "✕";
                        color: Theme.text-muted;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close-modal(); }
                    }
                }
            }

            // Tx hash (click-to-copy)
            Rectangle {
                background: hash-touch.has-hover ? Theme.bg-tertiary.brighter(0.2) : transparent;
                animate background { duration: Theme.duration-fast; }
                border-radius: Theme.radius-sm;
                height: 28px;
                HorizontalLayout {
                    padding: 4px;
                    Text { text: "Hash"; color: Theme.text-muted; font-size: 12px; min-width: 110px; vertical-alignment: center; }
                    Text { text: root.tx-hash; color: Theme.text; font-size: 11px; font-family: Theme.font-mono; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: hash-touch.has-hover ? "⧉" : " "; color: Theme.text-muted; font-size: 12px; width: 16px; }
                }
                hash-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.copy-text(root.tx-hash); }
                }
            }

            // Status pill
            HorizontalLayout {
                Text { text: "Status"; color: Theme.text-muted; font-size: 12px; min-width: 110px; vertical-alignment: center; }
                Rectangle {
                    width: 110px;
                    height: 24px;
                    border-radius: Theme.radius-full;
                    background:
                        root.status == "confirmed" ? Theme.success.with-alpha(0.18) :
                        root.status == "failed"    ? Theme.error.with-alpha(0.18)   :
                                                     Theme.warning.with-alpha(0.18);
                    border-width: 1px;
                    border-color:
                        root.status == "confirmed" ? Theme.success :
                        root.status == "failed"    ? Theme.error   :
                                                     Theme.warning;
                    Text {
                        text: root.status;
                        color:
                            root.status == "confirmed" ? Theme.success :
                            root.status == "failed"    ? Theme.error   :
                                                         Theme.warning;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            // Section: Parties
            Text { text: "Parties"; color: Theme.text-muted; font-size: 11px; font-weight: 500; }
            Rectangle {
                background: from-touch.has-hover ? Theme.bg-tertiary.brighter(0.2) : transparent;
                animate background { duration: Theme.duration-fast; }
                border-radius: Theme.radius-sm;
                height: 28px;
                HorizontalLayout {
                    padding: 4px;
                    Text { text: "From"; color: Theme.text-muted; font-size: 12px; min-width: 110px; vertical-alignment: center; }
                    Text { text: root.from-addr; color: Theme.text; font-size: 11px; font-family: Theme.font-mono; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: from-touch.has-hover ? "⧉" : " "; color: Theme.text-muted; font-size: 12px; width: 16px; }
                }
                from-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.copy-text(root.from-addr); }
                }
            }
            Rectangle {
                background: to-touch.has-hover ? Theme.bg-tertiary.brighter(0.2) : transparent;
                animate background { duration: Theme.duration-fast; }
                border-radius: Theme.radius-sm;
                height: 28px;
                HorizontalLayout {
                    padding: 4px;
                    Text { text: "To"; color: Theme.text-muted; font-size: 12px; min-width: 110px; vertical-alignment: center; }
                    Text {
                        text: root.to-addr == "" ? "(contract creation)" : root.to-addr;
                        color: root.to-addr == "" ? Theme.text-muted : Theme.text;
                        font-size: 11px; font-family: Theme.font-mono; overflow: elide; horizontal-stretch: 1; vertical-alignment: center;
                    }
                    Text { text: (root.to-addr != "" && to-touch.has-hover) ? "⧉" : " "; color: Theme.text-muted; font-size: 12px; width: 16px; }
                }
                to-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { if (root.to-addr != "") { root.copy-text(root.to-addr); } }
                }
            }
            HorizontalLayout {
                Text { text: "Value"; color: Theme.text-muted; font-size: 12px; min-width: 110px; vertical-alignment: center; }
                Text { text: root.value-display; color: Theme.text; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
            }
            HorizontalLayout {
                Text { text: "Nonce"; color: Theme.text-muted; font-size: 12px; min-width: 110px; vertical-alignment: center; }
                Text { text: root.nonce-display; color: Theme.text; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
            }
            HorizontalLayout {
                Text { text: "Block"; color: Theme.text-muted; font-size: 12px; min-width: 110px; vertical-alignment: center; }
                Text { text: "#" + root.block-height; color: Theme.text; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
            }

            // Section: Gas
            Text { text: "Gas"; color: Theme.text-muted; font-size: 11px; font-weight: 500; }
            HorizontalLayout {
                Text { text: "Gas used"; color: Theme.text-muted; font-size: 12px; min-width: 110px; vertical-alignment: center; }
                Text { text: root.gas-used-display; color: Theme.text; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
            }
            HorizontalLayout {
                Text { text: "Gas price"; color: Theme.text-muted; font-size: 12px; min-width: 110px; vertical-alignment: center; }
                Text { text: root.gas-price-display; color: Theme.text; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
            }

            // Section: Method
            Text { text: "Method"; color: Theme.text-muted; font-size: 11px; font-weight: 500; }
            HorizontalLayout {
                Text { text: "Decoded"; color: Theme.text-muted; font-size: 12px; min-width: 110px; vertical-alignment: center; }
                Text { text: root.method-label; color: Theme.accent; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
            }
            // Input hex — scrollable mono block (click to copy)
            Rectangle {
                background: input-touch.has-hover ? Theme.bg-tertiary.brighter(0.2) : Theme.bg-secondary;
                animate background { duration: Theme.duration-fast; }
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-subtle;
                min-height: 64px;
                max-height: 200px;
                vertical-stretch: 1;
                Flickable {
                    Text {
                        text: root.input-hex == "" ? "(empty calldata)" : root.input-hex;
                        color: root.input-hex == "" ? Theme.text-muted : Theme.text;
                        font-size: 10px;
                        font-family: Theme.font-mono;
                        wrap: word-wrap;
                        x: Theme.space-sm;
                        y: Theme.space-sm;
                        width: parent.width - 2 * Theme.space-sm;
                    }
                }
                input-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { if (root.input-hex != "") { root.copy-text(root.input-hex); } }
                }
            }

            Rectangle { vertical-stretch: 1; }

            // Footer: close
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 96px;
                    height: 32px;
                    border-radius: Theme.radius-sm;
                    background: footer-close-touch.has-hover ? Theme.accent-hover : Theme.accent;
                    Text {
                        text: "Close";
                        color: #ffffff;
                        font-size: 12px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    footer-close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close-modal(); }
                    }
                }
            }
        }
    }
}

export component DagExplorer inherits Rectangle {
    in property <int> current-height: 0;
    in property <bool> loading: false;
    in property <string> error: "";

    // T2-4: DAG-wide stats from citrate_getDagStats
    in property <int> dag-tips-count: 0;
    in property <int> dag-blue-score: 0;
    in property <int> dag-finalized-height: 0;
    // T2-13: DAG mini-viz scatter data (computed Rust-side from the
    // last ~30 blocks). Empty → "Waiting for blocks…" empty state.
    in property <[DagDotData]> dag-dots: [];

    // Detail view
    in property <bool> show-detail: false;
    in property <string> detail-hash: "";
    in property <int> detail-height: 0;
    in property <string> detail-timestamp: "";
    in property <int> detail-tx-count: 0;
    in property <string> detail-parent: "";
    in property <int> detail-blue-score: 0;
    in property <string> detail-proposer: "";

    // BFR-INT-5b: per-block transaction list (lazy-loaded on detail open).
    in property <[TxRowData]> detail-transactions: [];

    in-out property <string> search-query: "";

    callback search(string);
    callback select-block(int);
    callback back-to-list;
    callback copy-text(string);
    // BFR-INT-5b
    callback tx-row-clicked(string /* tx_hash */);

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.space-lg;
        spacing: Theme.space-lg;

        // Header + search
        HorizontalLayout {
            spacing: Theme.space-md;

            Text {
                text: "DAG Explorer";
                color: Theme.text;
                font-size: 24px;
                font-weight: 600;
                vertical-alignment: center;
            }

            // T2-4: DAG-wide stats from citrate_getDagStats RPC.
            // Three small inline metrics under the title.
            Rectangle {
                width: 220px; height: 36px;
                border-radius: Theme.radius-md;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border-subtle;
                HorizontalLayout {
                    padding: 6px;
                    spacing: Theme.space-md;
                    alignment: center;
                    Text {
                        text: root.dag-tips-count + " tips";
                        color: Theme.accent;
                        font-size: 11px;
                        font-family: Theme.font-mono;
                        vertical-alignment: center;
                    }
                    Text { text: "·"; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
                    Text {
                        text: "blue " + root.dag-blue-score;
                        color: Theme.text-secondary;
                        font-size: 11px;
                        font-family: Theme.font-mono;
                        vertical-alignment: center;
                    }
                    Text { text: "·"; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
                    Text {
                        text: "fin #" + root.dag-finalized-height;
                        color: Theme.text-secondary;
                        font-size: 11px;
                        font-family: Theme.font-mono;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Search
            Rectangle {
                width: 280px;
                height: 36px;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.bg-secondary;

                HorizontalLayout {
                    padding-left: Theme.space-md;
                    TextInput {
                        text <=> root.search-query;
                        font-size: 12px;
                        color: Theme.text;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        accepted => { root.search(root.search-query); }
                    }

                    Rectangle {
                        width: 50px;
                        Text { text: "Search"; color: Theme.accent; font-size: 11px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.search(root.search-query); } }
                    }
                }
            }
        }

        // Error state
        if root.error != "" : Rectangle {
            height: 40px;
            border-radius: Theme.radius-md;
            background: Theme.error;

            Text { text: root.error; color: #ffffff; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        }

        // Block detail view
        if root.show-detail : Rectangle {
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-subtle;
            vertical-stretch: 1;
            clip: true;

            VerticalLayout {
                padding: Theme.space-lg;
                spacing: Theme.space-md;

                // Back button
                HorizontalLayout {
                    Rectangle {
                        width: 60px;
                        height: 28px;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text { text: "← Back"; color: Theme.text-secondary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.back-to-list(); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                Text { text: "Block #" + root.detail-height; color: Theme.text; font-size: 20px; font-weight: 600; }

                // Fields
                VerticalLayout {
                    spacing: Theme.space-sm;

                    // Hash + Parent + Proposer are clickable-to-copy.
                    // TouchArea wraps the whole row and fires `copy-text`.
                    Rectangle {
                        background: hash-touch.has-hover ? Theme.bg-tertiary.brighter(0.2) : transparent;
                        animate background { duration: Theme.duration-fast; }
                        border-radius: Theme.radius-sm;
                        HorizontalLayout {
                            padding: 4px;
                            Text { text: "Hash"; color: Theme.text-muted; font-size: 12px; min-width: 120px; }
                            Text { text: root.detail-hash; color: Theme.text; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
                            Text { text: hash-touch.has-hover ? "⧉" : " "; color: Theme.text-muted; font-size: 12px; width: 16px; horizontal-alignment: right; }
                        }
                        hash-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.copy-text(root.detail-hash); }
                        }
                    }
                    HorizontalLayout { Text { text: "Height"; color: Theme.text-muted; font-size: 12px; min-width: 120px; } Text { text: root.detail-height; color: Theme.text; font-size: 12px; horizontal-stretch: 1; } }
                    HorizontalLayout { Text { text: "Timestamp"; color: Theme.text-muted; font-size: 12px; min-width: 120px; } Text { text: root.detail-timestamp; color: Theme.text; font-size: 12px; horizontal-stretch: 1; } }
                    HorizontalLayout { Text { text: "Transactions"; color: Theme.text-muted; font-size: 12px; min-width: 120px; } Text { text: root.detail-tx-count; color: Theme.text; font-size: 12px; horizontal-stretch: 1; } }
                    Rectangle {
                        background: parent-touch.has-hover ? Theme.bg-tertiary.brighter(0.2) : transparent;
                        animate background { duration: Theme.duration-fast; }
                        border-radius: Theme.radius-sm;
                        HorizontalLayout {
                            padding: 4px;
                            Text { text: "Selected Parent"; color: Theme.text-muted; font-size: 12px; min-width: 120px; }
                            Text { text: root.detail-parent; color: Theme.text; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
                            Text { text: parent-touch.has-hover ? "⧉" : " "; color: Theme.text-muted; font-size: 12px; width: 16px; horizontal-alignment: right; }
                        }
                        parent-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.copy-text(root.detail-parent); }
                        }
                    }
                    HorizontalLayout { Text { text: "Blue Score"; color: Theme.text-muted; font-size: 12px; min-width: 120px; } Text { text: root.detail-blue-score; color: Theme.text; font-size: 12px; horizontal-stretch: 1; } }
                    Rectangle {
                        background: prop-touch.has-hover ? Theme.bg-tertiary.brighter(0.2) : transparent;
                        animate background { duration: Theme.duration-fast; }
                        border-radius: Theme.radius-sm;
                        HorizontalLayout {
                            padding: 4px;
                            Text { text: "Proposer"; color: Theme.text-muted; font-size: 12px; min-width: 120px; }
                            Text { text: root.detail-proposer; color: Theme.text; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
                            Text { text: prop-touch.has-hover ? "⧉" : " "; color: Theme.text-muted; font-size: 12px; width: 16px; horizontal-alignment: right; }
                        }
                        prop-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.copy-text(root.detail-proposer); }
                        }
                    }
                }

                // BFR-INT-5b: transaction list — empty state if none, else rows.
                Text {
                    text: "Transactions (" + root.detail-transactions.length + ")";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                }
                if root.detail-transactions.length == 0 : Rectangle {
                    height: 48px;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    background: Theme.bg-secondary;
                    Text {
                        text: root.detail-tx-count == 0
                            ? "No transactions in this block"
                            : "Loading transactions…";
                        color: Theme.text-muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if root.detail-transactions.length > 0 : Rectangle {
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    background: Theme.bg-secondary;
                    min-height: 80px;
                    vertical-stretch: 1;
                    clip: true;
                    Flickable {
                        VerticalLayout {
                            for tx in root.detail-transactions : TxListRow {
                                data: tx;
                                clicked => { root.tx-row-clicked(tx.tx-hash); }
                            }
                        }
                    }
                }
            }
        }

        // Block list view
        // T2-13: DAG mini-viz scatter. Sits above the list so
        // "shape of recent DAG" is the first thing users see.
        if !root.show-detail : DagMiniViz {
            dots: root.dag-dots;
            window-size: 30;
            min-height: 180px;
            vertical-stretch: 0;
        }

        if !root.show-detail : Rectangle {
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-subtle;
            vertical-stretch: 1;
            clip: true;

            VerticalLayout {
                // Header
                Rectangle {
                    height: 32px;
                    background: Theme.bg-secondary;

                    HorizontalLayout {
                        padding-left: Theme.space-md;
                        padding-right: Theme.space-md;
                        spacing: Theme.space-lg;

                        Text { text: "Height"; color: Theme.text-muted; font-size: 11px; font-weight: 500; min-width: 80px; vertical-alignment: center; }
                        Text { text: "Hash"; color: Theme.text-muted; font-size: 11px; font-weight: 500; min-width: 100px; vertical-alignment: center; }
                        Text { text: "Txns"; color: Theme.text-muted; font-size: 11px; font-weight: 500; min-width: 60px; vertical-alignment: center; }
                        Text { text: "Time"; color: Theme.text-muted; font-size: 11px; font-weight: 500; vertical-alignment: center; }
                    }
                }

                if root.loading : Text {
                    text: "Loading blocks...";
                    color: Theme.text-muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if !root.loading && root.current-height == 0 : Text {
                    text: "No blocks yet — start node to see blocks";
                    color: Theme.text-muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                // Recent blocks (generated from current height)
                if !root.loading && root.current-height > 0 : Flickable {
                    VerticalLayout {
                        for i in min(root.current-height, 20) : BlockListRow {
                            height-val: root.current-height - i;
                            hash-short: "block...";
                            time-text: i * 5 + "s ago";
                            tx-count: 0;
                            clicked => { root.select-block(root.current-height - i); }
                        }
                    }
                }
            }
        }
    }
}
