// Send SALT dialog — address, amount, confirm, result
import { Theme } from "@citrate-ui-kit";
import { PrimaryButton, SecondaryButton } from "@citrate-ui-kit";

export component SendDialog inherits Rectangle {
    in property <string> from-address: "";
    in property <string> balance: "0";
    in-out property <string> to-address: "";
    in-out property <string> amount: "";
    in-out property <string> password: "";
    in property <string> error-message: "";
    in property <bool> sending: false;
    in property <string> tx-hash: "";
    // T1-1: live receipt outcome — updates from "Submitted — waiting…"
    // to "Confirmed in block 0x…" (or Reverted / Pending / poll error).
    in property <string> receipt-status: "";
    in-out property <bool> confirming: false;

    // EW-S1 WP-8: paymaster-sponsored send from the linked Citrate
    // smart wallet (root validator = this device's key).
    in property <bool> sponsored-available: false;
    in property <string> smart-wallet: "";
    in-out property <bool> sponsored: false;

    callback send(/* to */ string, /* amount */ string, /* password */ string);
    callback send-sponsored(/* to */ string, /* amount */ string);
    callback close;

    // Overlay
    background: rgba(0, 0, 0, 0.6);

    TouchArea { clicked => { root.close(); } }

    // Dialog — responsive width (Sprint P950-C WP-C.7).
    // Was `width: 440px` (overflowed the window on narrow screens).
    // New pattern: prefer 440px, but shrink to window width minus 32px
    // padding on both sides when the window is narrower.
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(440px, parent.width - 32px);
        min-height: 300px;
        border-radius: Theme.radius-lg;
        background: Theme.bg;
        border-width: 1px;
        border-color: Theme.border;
        // Elevation: dialog lifts off the overlay
        drop-shadow-offset-y: Theme.shadow-offset-lg;
        drop-shadow-blur: Theme.shadow-blur-lg;
        drop-shadow-color: Theme.shadow-color-lg;

        TouchArea {} // Block click-through

        VerticalLayout {
            padding: Theme.space-xl;
            spacing: Theme.space-lg;

            // Success state
            if root.tx-hash != "" : VerticalLayout {
                spacing: Theme.space-lg;
                alignment: center;

                // Checkmark
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: Theme.success;
                    horizontal-stretch: 0;

                    Text { text: "✓"; color: Theme.on-solid; font-size: 24px; horizontal-alignment: center; vertical-alignment: center; }
                }

                Text { text: "Transaction Sent"; color: Theme.success; font-family: Theme.font-display; font-size: 20px; font-weight: 600; horizontal-alignment: center; }
                Text { text: root.amount + " SALT sent"; color: Theme.text-secondary; font-size: 13px; horizontal-alignment: center; }

                Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface;
                    min-height: 40px;

                    VerticalLayout {
                        padding: Theme.space-md;
                        spacing: 2px;
                        Text { text: "Transaction Hash"; color: Theme.text-muted; font-size: 10px; }
                        Text { text: root.tx-hash; color: Theme.text; font-size: 11px; font-family: Theme.font-mono; overflow: elide; }
                    }
                }

                // T1-1: receipt poll status. Empty initially, then cycles
                // "waiting…" → "Confirmed in block N" (or Reverted / Pending).
                if root.receipt-status != "" : Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.bg-tertiary;
                    min-height: 36px;
                    VerticalLayout {
                        padding: Theme.space-sm;
                        spacing: 2px;
                        Text { text: "Receipt"; color: Theme.text-muted; font-size: 10px; }
                        Text { text: root.receipt-status; color: Theme.text; font-size: 11px; wrap: word-wrap; }
                    }
                }

                PrimaryButton {
                    text: "Done";
                    clicked => { root.close(); }
                }
            }

            // Confirm state
            if root.tx-hash == "" && root.confirming : VerticalLayout {
                spacing: Theme.space-md;

                Text { text: "Confirm Transaction"; color: Theme.text; font-family: Theme.font-display; font-size: 18px; font-weight: 600; }

                Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface;
                    min-height: 100px;

                    VerticalLayout {
                        padding: Theme.space-md;
                        spacing: Theme.space-sm;

                        HorizontalLayout {
                            Text { text: "To"; color: Theme.text-muted; font-size: 12px; min-width: 60px; }
                            Text { text: root.to-address; color: Theme.text; font-size: 12px; overflow: elide; }
                        }
                        HorizontalLayout {
                            Text { text: "Amount"; color: Theme.text-muted; font-size: 12px; min-width: 60px; }
                            Text { text: root.amount + " SALT"; color: Theme.text; font-size: 12px; font-weight: 600; }
                        }
                        HorizontalLayout {
                            Text { text: "Gas"; color: Theme.text-muted; font-size: 12px; min-width: 60px; }
                            Text { text: root.sponsored ? "Sponsored by Citrate" : "21,000"; color: Theme.text; font-size: 12px; }
                        }
                    }
                }

                if root.error-message != "" : Text { text: root.error-message; color: Theme.error; font-size: 12px; }

                HorizontalLayout {
                    spacing: Theme.space-sm;

                    SecondaryButton {
                        text: "Back";
                        horizontal-stretch: 1;
                        clicked => { root.confirming = false; }
                    }

                    PrimaryButton {
                        text: root.sending ? "Sending..." : "Confirm & Send";
                        disabled: root.sending;
                        horizontal-stretch: 1;
                        clicked => {
                            if (root.sponsored) {
                                root.send-sponsored(root.to-address, root.amount);
                            } else {
                                root.send(root.to-address, root.amount, root.password);
                            }
                        }
                    }
                }
            }

            // Input state
            if root.tx-hash == "" && !root.confirming : VerticalLayout {
                spacing: Theme.space-md;

                Text { text: "Send SALT"; color: Theme.text; font-family: Theme.font-display; font-size: 18px; font-weight: 600; }

                // From
                VerticalLayout {
                    spacing: 2px;
                    Text { text: root.sponsored ? "FROM (SMART WALLET)" : "FROM"; color: Theme.text-muted; font-size: 11px; font-weight: 500; }
                    Text { text: root.sponsored ? root.smart-wallet : root.from-address; color: Theme.text-muted; font-size: 12px; overflow: elide; }
                }

                // EW-S1 WP-8: sponsored-mode toggle (only when linked).
                if root.sponsored-available : VerticalLayout {
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        Rectangle {
                            width: 16px; height: 16px; border-radius: 4px; y: 1px;
                            border-width: 1px;
                            border-color: root.sponsored ? Theme.accent : Theme.border;
                            background: root.sponsored ? Theme.accent : Theme.bg-secondary;
                            if root.sponsored : Text { text: "✓"; color: Theme.on-accent; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.sponsored = !root.sponsored; } }
                        }
                        Text { text: "Send from smart wallet (gas sponsored by Citrate)"; color: Theme.text; font-size: 12px; vertical-alignment: center; }
                    }
                    if root.sponsored : Text {
                        text: "Small-value only — the Citrate wallet contracts are awaiting external audit.";
                        color: Theme.warning; font-size: 11px; wrap: word-wrap;
                    }
                }

                // To address
                VerticalLayout {
                    spacing: 2px;
                    Text { text: "TO ADDRESS"; color: Theme.text-muted; font-size: 11px; font-weight: 500; }
                    Rectangle {
                        height: 40px;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.bg-secondary;
                        TextInput {
                            text <=> root.to-address;
                            font-size: 13px;
                            color: Theme.text;
                            x: Theme.space-md;
                            width: parent.width - Theme.space-2xl;
                            vertical-alignment: center;
                        }
                    }
                }

                // Amount
                VerticalLayout {
                    spacing: 2px;
                    Text { text: "AMOUNT (SALT)"; color: Theme.text-muted; font-size: 11px; font-weight: 500; }
                    Rectangle {
                        height: 40px;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.bg-secondary;
                        TextInput {
                            text <=> root.amount;
                            font-size: 13px;
                            color: Theme.text;
                            x: Theme.space-md;
                            width: parent.width - Theme.space-2xl;
                            vertical-alignment: center;
                        }
                    }
                }

                // Password
                VerticalLayout {
                    spacing: 2px;
                    Text { text: "PASSWORD"; color: Theme.text-muted; font-size: 11px; font-weight: 500; }
                    Rectangle {
                        height: 40px;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.bg-secondary;
                        TextInput {
                            text <=> root.password;
                            font-size: 13px;
                            color: Theme.text;
                            input-type: InputType.password;
                            x: Theme.space-md;
                            width: parent.width - Theme.space-2xl;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.error-message != "" : Text { text: root.error-message; color: Theme.error; font-size: 12px; }

                HorizontalLayout {
                    spacing: Theme.space-sm;

                    SecondaryButton {
                        text: "Cancel";
                        horizontal-stretch: 1;
                        clicked => { root.close(); }
                    }

                    PrimaryButton {
                        text: "Review";
                        horizontal-stretch: 1;
                        clicked => { root.confirming = true; }
                    }
                }
            }
        }
    }
}
