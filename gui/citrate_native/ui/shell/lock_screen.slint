// Lock screen — returning user password entry
import { Theme } from "@citrate-ui-kit";

export component LockScreen inherits Rectangle {
    in-out property <string> password: "";
    in property <string> error-message: "";
    in property <bool> unlocking: false;
    in property <bool> locked-out: false;
    in property <string> lockout-message: "";

    callback unlock(string);
    callback sign-out;

    background: Theme.bg;

    VerticalLayout {
        alignment: center;
        spacing: Theme.space-xl;
        padding: Theme.space-2xl;

        // Logo
        Text {
            text: "Citrate";
            color: Theme.accent;
            font-size: 36px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: "Welcome Back";
            color: Theme.text;
            font-size: 22px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        // Password input
        Rectangle {
            max-width: 360px;
            horizontal-stretch: 0;

            VerticalLayout {
                spacing: Theme.space-md;

                // Label
                Text {
                    text: "PASSWORD";
                    color: Theme.text-muted;
                    font-size: 11px;
                    font-weight: 500;
                    letter-spacing: 0.5px;
                }

                // Input field
                Rectangle {
                    height: 44px;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: root.error-message != "" ? Theme.error : Theme.border;
                    background: Theme.bg-secondary;

                    TextInput {
                        text <=> root.password;
                        font-size: 14px;
                        color: Theme.text;
                        input-type: InputType.password;
                        x: Theme.space-md;
                        width: parent.width - Theme.space-2xl;
                        vertical-alignment: center;
                        accepted => { if !root.unlocking && !root.locked-out { root.unlock(root.password); } }
                    }
                }

                // Error
                if root.error-message != "" : Text {
                    text: root.error-message;
                    color: Theme.error;
                    font-size: 12px;
                    horizontal-alignment: center;
                }

                // Lockout warning
                if root.locked-out : Text {
                    text: root.lockout-message;
                    color: Theme.warning;
                    font-size: 12px;
                    horizontal-alignment: center;
                }

                // Unlock button
                Rectangle {
                    property <bool> ready: !root.locked-out && !root.unlocking;
                    height: 42px;
                    border-radius: Theme.radius-md;
                    background: !self.ready ? Theme.bg-tertiary :
                                (unlock-touch.pressed ? Theme.accent-hover.darker(0.15) :
                                 (unlock-touch.has-hover ? Theme.accent-hover : Theme.accent));
                    animate background { duration: Theme.duration-fast; }
                    opacity: self.ready ? 1.0 : 0.5;

                    Text {
                        text: root.unlocking ? "Unlocking..." :
                              root.locked-out ? "Locked Out" : "Unlock";
                        color: parent.ready ? Theme.on-accent : Theme.text-muted;
                        font-size: Theme.font-size-md;
                        font-weight: Theme.font-weight-semibold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    unlock-touch := TouchArea {
                        mouse-cursor: parent.ready ? pointer : default;
                        clicked => {
                            if !root.unlocking && !root.locked-out {
                                root.unlock(root.password);
                            }
                        }
                    }
                }

                // Sign out link
                Rectangle {
                    height: 32px;
                    background: signout-touch.pressed ? Theme.bg-secondary :
                                (signout-touch.has-hover ? Theme.bg-tertiary : transparent);
                    border-radius: Theme.radius-sm;
                    animate background { duration: Theme.duration-fast; }

                    Text {
                        text: "Sign Out";
                        color: signout-touch.has-hover ? Theme.text : Theme.text-muted;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        animate color { duration: Theme.duration-fast; }
                    }

                    signout-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.sign-out(); }
                    }
                }
            }
        }
    }
}
