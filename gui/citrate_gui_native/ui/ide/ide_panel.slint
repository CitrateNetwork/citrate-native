// IDE Panel — VSCode-like layout with file explorer, editor, terminal, git
// Can be used inline in a tab or popped out to a standalone window
import { Theme } from "../theme.slint";
import { FileTreeNodeData, EditorTabData, StyledLineData, TerminalRowData,
         GitFileData, DiagnosticData } from "ide_structs.slint";
import { FileExplorer } from "file_explorer.slint";
import { TabBar } from "tab_bar.slint";
import { EditorArea } from "editor_area.slint";
import { BottomPanel } from "bottom_panel.slint";
import { GitPanel } from "git_panel.slint";
import { StatusBarIde } from "status_bar_ide.slint";

export component IdePanel inherits Rectangle {
    // === File Explorer State ===
    in property <string> explorer-root: "";
    in property <[FileTreeNodeData]> file-tree-nodes: [];
    in property <string> selected-file-path: "";

    // === Tab Bar State ===
    in property <[EditorTabData]> tabs: [];

    // === Editor State ===
    in property <[StyledLineData]> visible-lines: [];
    in property <int> total-lines: 0;
    in property <int> scroll-offset: 0;
    in property <int> cursor-line: 0;
    in property <int> cursor-col: 0;

    // === Terminal State ===
    in property <[TerminalRowData]> terminal-rows: [];
    in property <int> terminal-cursor-row: 0;
    in property <int> terminal-cursor-col: 0;

    // === Git State ===
    in property <string> git-branch: "";
    in property <[GitFileData]> git-changed-files: [];

    // === Diagnostics ===
    in property <[DiagnosticData]> diagnostics: [];

    // === Panel Visibility ===
    in-out property <bool> show-explorer: true;
    in-out property <bool> show-git: false;
    in-out property <bool> show-bottom-panel: true;

    // === Language / Status ===
    in property <string> active-language: "";
    in property <int> error-count: 0;
    in property <int> warning-count: 0;

    // === Command Palette / Search ===
    in-out property <bool> show-command-palette: false;
    in-out property <string> command-palette-query: "";
    in-out property <bool> show-search-panel: false;
    in-out property <string> search-query: "";
    in property <[DiagnosticData]> search-results: [];

    // === Callbacks to Rust ===
    callback file-opened(string);
    callback dir-toggled(string);
    callback tab-clicked(string);
    callback tab-closed(string);
    callback editor-key-pressed(string);
    callback terminal-input(string);
    callback terminal-resize(int, int);
    callback git-stage(string);
    callback git-unstage(string);
    callback git-commit(string);
    callback git-push;
    callback git-pull;
    callback save-file;
    callback save-all;
    callback pop-out;
    callback command-palette-execute(string);
    callback search-in-files(string);

    background: Theme.bg;

    VerticalLayout {
        // === Toolbar ===
        Rectangle {
            height: 32px;
            background: Theme.bg-secondary;

            HorizontalLayout {
                padding-left: Theme.space-md;
                padding-right: Theme.space-md;
                spacing: Theme.space-sm;

                // Toggle buttons
                Rectangle {
                    width: 28px; height: 24px; border-radius: Theme.radius-sm;
                    background: root.show-explorer ? Theme.bg-tertiary : transparent;
                    y: 4px;
                    Text { text: "Files"; color: root.show-explorer ? Theme.text : Theme.text-muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.show-explorer = !root.show-explorer; } }
                }

                Rectangle {
                    width: 24px; height: 24px; border-radius: Theme.radius-sm;
                    background: root.show-git ? Theme.bg-tertiary : transparent;
                    y: 4px;
                    Text { text: "Git"; color: root.show-git ? Theme.text : Theme.text-muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.show-git = !root.show-git; } }
                }

                Rectangle {
                    width: 40px; height: 24px; border-radius: Theme.radius-sm;
                    background: root.show-bottom-panel ? Theme.bg-tertiary : transparent;
                    y: 4px;
                    Text { text: "Terminal"; color: root.show-bottom-panel ? Theme.text : Theme.text-muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.show-bottom-panel = !root.show-bottom-panel; } }
                }

                Rectangle { horizontal-stretch: 1; }

                // Search button
                Rectangle {
                    width: 40px; height: 24px; border-radius: Theme.radius-sm;
                    background: root.show-search-panel ? Theme.bg-tertiary : transparent;
                    y: 4px;
                    Text { text: "Search"; color: root.show-search-panel ? Theme.text : Theme.text-muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.show-search-panel = !root.show-search-panel; } }
                }

                // Command palette button
                Rectangle {
                    width: 24px; height: 24px; border-radius: Theme.radius-sm;
                    y: 4px;
                    Text { text: ">_"; color: Theme.text-muted; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.show-command-palette = true; } }
                }

                // Pop-out button
                Rectangle {
                    width: 50px; height: 24px; border-radius: Theme.radius-sm;
                    border-width: 1px; border-color: Theme.border;
                    y: 4px;
                    Text { text: "Pop Out"; color: Theme.text-muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.pop-out(); } }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border-subtle; }

        // === Main Content ===
        HorizontalLayout {
            vertical-stretch: 1;

            // === Left Sidebar: File Explorer + Git (200px) ===
            if root.show-explorer : Rectangle {
                width: 200px;
                background: Theme.bg-secondary;

                VerticalLayout {
                    FileExplorer {
                        root-path: root.explorer-root;
                        nodes: root.file-tree-nodes;
                        selected-path: root.selected-file-path;
                        vertical-stretch: root.show-git ? 2 : 1;
                        file-clicked(path) => { root.file-opened(path); }
                        dir-toggled(path) => { root.dir-toggled(path); }
                    }

                    if root.show-git : Rectangle {
                        height: 1px;
                        background: Theme.border-subtle;
                    }

                    if root.show-git : GitPanel {
                        branch: root.git-branch;
                        changed-files: root.git-changed-files;
                        vertical-stretch: 1;
                        stage(path) => { root.git-stage(path); }
                        unstage(path) => { root.git-unstage(path); }
                        commit(msg) => { root.git-commit(msg); }
                        push => { root.git-push(); }
                        pull => { root.git-pull(); }
                    }
                }
            }

            if root.show-explorer : Rectangle {
                width: 1px;
                background: Theme.border-subtle;
            }

            // === Center: Tabs + Editor + Bottom Panel ===
            VerticalLayout {
                horizontal-stretch: 1;

                TabBar {
                    tabs: root.tabs;
                    tab-clicked(id) => { root.tab-clicked(id); }
                    tab-closed(id) => { root.tab-closed(id); }
                }

                EditorArea {
                    visible-lines: root.visible-lines;
                    total-lines: root.total-lines;
                    scroll-offset: root.scroll-offset;
                    cursor-line: root.cursor-line;
                    cursor-col: root.cursor-col;
                    vertical-stretch: 3;  // Editor gets 3x the space of terminal
                    key-pressed(key) => { root.editor-key-pressed(key); }
                }

                if root.show-bottom-panel : Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }

                if root.show-bottom-panel : BottomPanel {
                    terminal-rows: root.terminal-rows;
                    terminal-cursor-row: root.terminal-cursor-row;
                    terminal-cursor-col: root.terminal-cursor-col;
                    diagnostics: root.diagnostics;
                    vertical-stretch: 1;
                    terminal-input(key) => { root.terminal-input(key); }
                    toggle-panel => { root.show-bottom-panel = false; }
                }
            }
        }

        StatusBarIde {
            branch: root.git-branch;
            cursor-line: root.cursor-line;
            cursor-col: root.cursor-col;
            language: root.active-language;
            error-count: root.error-count;
            warning-count: root.warning-count;
        }
    }

    // === Welcome State (no file open) ===
    if root.tabs.length == 0 && !root.show-command-palette : Rectangle {
        x: root.show-explorer ? 201px : 0px;
        y: 33px;
        width: root.width - (root.show-explorer ? 201px : 0px);
        height: root.height - 65px;
        background: Theme.bg;

        VerticalLayout {
            alignment: center;
            spacing: Theme.space-lg;
            padding: Theme.space-2xl;

            Text { text: "Citrate Contracts IDE"; color: Theme.text; font-size: 24px; font-weight: 700; horizontal-alignment: center; }
            Text { text: "Open a file from the explorer or use the command palette"; color: Theme.text-muted; font-size: 13px; horizontal-alignment: center; }

            VerticalLayout {
                spacing: Theme.space-sm;
                alignment: center;
                padding-top: Theme.space-xl;

                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.space-sm;
                    Text { text: "Ctrl+P"; color: Theme.accent; font-size: 11px; font-weight: 600; }
                    Text { text: "Command Palette"; color: Theme.text-muted; font-size: 11px; }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.space-sm;
                    Text { text: "Ctrl+F"; color: Theme.accent; font-size: 11px; font-weight: 600; }
                    Text { text: "Search in Files"; color: Theme.text-muted; font-size: 11px; }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.space-sm;
                    Text { text: "Ctrl+`"; color: Theme.accent; font-size: 11px; font-weight: 600; }
                    Text { text: "Toggle Terminal"; color: Theme.text-muted; font-size: 11px; }
                }
            }
        }
    }

    // === Command Palette Overlay ===
    if root.show-command-palette : Rectangle {
        background: rgba(0, 0, 0, 0.4);

        TouchArea { clicked => { root.show-command-palette = false; } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 60px;
            width: min(500px, parent.width - 80px);
            height: 200px;
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: rgba(0, 0, 0, 0.3);

            VerticalLayout {
                padding: Theme.space-sm;
                spacing: Theme.space-xs;

                // Search input
                Rectangle {
                    height: 36px;
                    border-radius: Theme.radius-md;
                    background: Theme.bg;
                    border-width: 1px;
                    border-color: Theme.accent;

                    HorizontalLayout {
                        padding-left: Theme.space-md;
                        spacing: Theme.space-sm;
                        Text { text: ">"; color: Theme.accent; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                        cmd-input := TextInput {
                            text <=> root.command-palette-query;
                            font-size: 13px;
                            color: Theme.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            accepted => {
                                if root.command-palette-query != "" {
                                    root.command-palette-execute(root.command-palette-query);
                                    root.show-command-palette = false;
                                    root.command-palette-query = "";
                                }
                            }
                        }
                    }
                }

                // Quick actions
                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 1px;

                        for cmd in [
                            { label: "Compile Contracts", key: "compile" },
                            { label: "Run Tests", key: "test" },
                            { label: "Deploy Contract", key: "deploy" },
                            { label: "Toggle Terminal", key: "terminal" },
                            { label: "Toggle Git Panel", key: "git" },
                            { label: "Save File", key: "save" },
                        ] : Rectangle {
                            height: 28px;
                            border-radius: Theme.radius-sm;
                            background: cmd-hover.has-hover ? Theme.bg-tertiary : transparent;

                            HorizontalLayout {
                                padding-left: Theme.space-md;
                                Text { text: cmd.label; color: Theme.text; font-size: 12px; vertical-alignment: center; }
                            }
                            cmd-hover := TouchArea {
                                clicked => {
                                    root.command-palette-execute(cmd.key);
                                    root.show-command-palette = false;
                                    root.command-palette-query = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // === Search Panel Overlay (inline, not modal) ===
    if root.show-search-panel : Rectangle {
        x: root.show-explorer ? 201px : 0px;
        y: 33px;
        width: 300px;
        height: root.height - 65px;
        background: Theme.bg-secondary;
        border-width: 0px;
        border-color: Theme.border-subtle;

        VerticalLayout {
            padding: Theme.space-md;
            spacing: Theme.space-sm;

            HorizontalLayout {
                alignment: space-between;
                Text { text: "Search"; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                Rectangle {
                    width: 20px; height: 20px; border-radius: Theme.radius-sm;
                    Text { text: "x"; color: Theme.text-muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.show-search-panel = false; } }
                }
            }

            Rectangle {
                height: 28px; border-radius: Theme.radius-sm;
                background: Theme.bg; border-width: 1px; border-color: Theme.border;

                TextInput {
                    text <=> root.search-query;
                    font-size: 12px; color: Theme.text;
                    x: Theme.space-sm; width: parent.width - Theme.space-lg;
                    vertical-alignment: center;
                    accepted => { root.search-in-files(root.search-query); }
                }
            }

            // Search results (reuse DiagnosticData for file:line display)
            Flickable {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 2px;

                    if root.search-results.length == 0 : VerticalLayout {
                        padding-top: Theme.space-xl;
                        Text {
                            text: root.search-query == "" ? "Type to search" : "No results";
                            color: Theme.text-muted; font-size: 11px;
                            horizontal-alignment: center;
                        }
                    }

                    for result in root.search-results : Rectangle {
                        height: 36px; border-radius: Theme.radius-sm;
                        background: result-hover.has-hover ? Theme.bg-tertiary : transparent;

                        VerticalLayout {
                            padding-left: Theme.space-sm;
                            padding-top: Theme.space-xs;
                            Text { text: result.file-path; color: Theme.text; font-size: 10px; overflow: elide; }
                            HorizontalLayout {
                                spacing: Theme.space-xs;
                                Text { text: result.message; color: Theme.text-secondary; font-size: 10px; overflow: elide; }
                            }
                        }
                        result-hover := TouchArea {
                            clicked => { root.file-opened(result.file-path); }
                        }
                    }
                }
            }
        }
    }
}
