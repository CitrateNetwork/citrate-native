// Bottom panel — tabbed panel with Terminal, Output, Problems
import { Theme } from "../theme.slint";
import { TerminalRowData, DiagnosticData } from "ide_structs.slint";
import { TerminalGrid } from "terminal_grid.slint";

component PanelTab inherits Rectangle {
    in property <string> label;
    in property <bool> is-active: false;
    in property <int> badge-count: 0;
    callback clicked;

    height: 28px;
    min-width: 80px;

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-xs;
        alignment: center;

        Text {
            text: root.label;
            color: root.is-active ? Theme.text : Theme.text-muted;
            font-size: 12px;
            font-weight: root.is-active ? 600 : 400;
            vertical-alignment: center;
        }

        if root.badge-count > 0 : Rectangle {
            width: 18px;
            height: 14px;
            border-radius: 7px;
            background: root.label == "Problems" ? Theme.error : Theme.info;
            Text {
                text: root.badge-count;
                color: #ffffff;
                font-size: 9px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.is-active ? Theme.accent : transparent;
    }

    TouchArea { clicked => { root.clicked(); } }
}

component DiagnosticRow inherits Rectangle {
    in property <string> severity;
    in property <string> message;
    in property <string> file-path;
    in property <int> line;
    in property <int> column;

    height: 24px;

    HorizontalLayout {
        padding-left: Theme.space-sm;
        spacing: Theme.space-sm;

        Text {
            text: root.severity == "error" ? "✕" : root.severity == "warning" ? "⚠" : "ℹ";
            color: root.severity == "error" ? Theme.error :
                   root.severity == "warning" ? Theme.warning : Theme.info;
            font-size: 12px;
            width: 16px;
            vertical-alignment: center;
        }

        Text {
            text: root.message;
            color: Theme.text-secondary;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Text {
            text: root.file-path + ":" + root.line + ":" + root.column;
            color: Theme.text-muted;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    TouchArea {}
}

export component BottomPanel inherits Rectangle {
    in-out property <string> active-tab: "terminal";

    in property <[TerminalRowData]> terminal-rows: [];
    in property <int> terminal-cursor-row: 0;
    in property <int> terminal-cursor-col: 0;
    in property <bool> terminal-cursor-visible: true;
    in property <[DiagnosticData]> diagnostics: [];
    in property <[string]> output-lines: [];

    callback terminal-input(string);
    callback terminal-resize(int, int);
    callback toggle-panel;

    background: Theme.bg;

    VerticalLayout {
        Rectangle {
            height: 28px;
            background: Theme.bg-secondary;

            HorizontalLayout {
                PanelTab {
                    label: "Terminal";
                    is-active: root.active-tab == "terminal";
                    clicked => { root.active-tab = "terminal"; }
                }
                PanelTab {
                    label: "Output";
                    is-active: root.active-tab == "output";
                    clicked => { root.active-tab = "output"; }
                }
                PanelTab {
                    label: "Problems";
                    is-active: root.active-tab == "problems";
                    badge-count: root.diagnostics.length;
                    clicked => { root.active-tab = "problems"; }
                }

                Rectangle { horizontal-stretch: 1; }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    Text { text: "×"; color: Theme.text-muted; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.toggle-panel(); } }
                }
            }

            Rectangle {
                y: 0px;
                height: 1px;
                background: Theme.border-subtle;
            }
        }

        Rectangle {
            vertical-stretch: 1;

            if root.active-tab == "terminal" : TerminalGrid {
                rows: root.terminal-rows;
                cursor-row: root.terminal-cursor-row;
                cursor-col: root.terminal-cursor-col;
                cursor-visible: root.terminal-cursor-visible;
                input(key) => { root.terminal-input(key); }
            }

            if root.active-tab == "output" : Flickable {
                VerticalLayout {
                    padding: Theme.space-sm;
                    for line in root.output-lines : Text {
                        text: line;
                        color: Theme.text-secondary;
                        font-size: 12px;
                    }
                    if root.output-lines.length == 0 : Text {
                        text: "No output";
                        color: Theme.text-muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }
            }

            if root.active-tab == "problems" : Flickable {
                VerticalLayout {
                    for diag in root.diagnostics : DiagnosticRow {
                        severity: diag.severity;
                        message: diag.message;
                        file-path: diag.file-path;
                        line: diag.line;
                        column: diag.column;
                    }
                    if root.diagnostics.length == 0 : Rectangle {
                        height: 40px;
                        Text { text: "No problems detected"; color: Theme.text-muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
