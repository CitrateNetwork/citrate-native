// Tab bar — file tabs with dirty indicators and close buttons
import { Theme } from "../theme.slint";
import { EditorTabData } from "ide_structs.slint";

component EditorTab inherits Rectangle {
    in property <string> tab-id;
    in property <string> name;
    in property <bool> is-dirty: false;
    in property <bool> is-active: false;
    in property <string> language: "";
    callback clicked;
    callback close-clicked;

    height: 34px;
    min-width: 120px;
    max-width: 200px;
    background: root.is-active ? Theme.bg : Theme.bg-secondary;

    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.is-active ? Theme.accent : transparent;
    }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-xs;
        spacing: Theme.space-sm;
        alignment: start;

        if root.is-dirty : Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: Theme.accent;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.name;
            color: root.is-active ? Theme.text : Theme.text-secondary;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.language != "" && root.is-active : Rectangle {
            width: 30px;
            height: 16px;
            border-radius: 3px;
            background: Theme.bg-tertiary;

            Text {
                text: root.language == "Solidity" ? "sol" :
                      root.language == "Rust" ? "rs" :
                      root.language == "TypeScript" ? "ts" :
                      root.language == "JavaScript" ? "js" :
                      root.language == "Python" ? "py" :
                      root.language == "JSON" ? "{}" : "txt";
                color: Theme.text-muted;
                font-size: 9px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 3px;
            Text {
                text: "×";
                color: Theme.text-muted;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { clicked => { root.close-clicked(); } }
        }
    }

    TouchArea { clicked => { root.clicked(); } }
}

export component TabBar inherits Rectangle {
    in property <[EditorTabData]> tabs: [];
    callback tab-clicked(string);
    callback tab-closed(string);

    height: 34px;
    background: Theme.bg-secondary;

    HorizontalLayout {
        for tab in root.tabs : EditorTab {
            tab-id: tab.id;
            name: tab.name;
            is-dirty: tab.dirty;
            is-active: tab.active;
            language: tab.language;
            clicked => { root.tab-clicked(tab.id); }
            close-clicked => { root.tab-closed(tab.id); }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg-secondary;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border-subtle;
    }
}
