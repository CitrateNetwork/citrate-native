// IDE data structs — named types for Rust API interop
// These generate predictable Rust struct names via slint::include_modules!()

export struct FileTreeNodeData {
    name: string,
    path: string,
    is-directory: bool,
    is-expanded: bool,
    depth: int,
    file-type: string,
    git-status: string,
}

export struct EditorTabData {
    id: string,
    name: string,
    language: string,
    dirty: bool,
    active: bool,
}

export struct StyledSpanData {
    text: string,
    fg-color: color,
    bold: bool,
}

export struct StyledLineData {
    line-number: int,
    spans: [StyledSpanData],
}

export struct TerminalCellData {
    char: string,
    fg-color: color,
    bg-color: color,
    bold: bool,
}

export struct TerminalRowData {
    cells: [TerminalCellData],
}

export struct GitFileData {
    path: string,
    change-type: string,
    staged: bool,
}

export struct DiagnosticData {
    severity: string,
    message: string,
    file-path: string,
    line: int,
    column: int,
}
