// Sidebar navigation — grouped nav items matching current GUI
import { Theme } from "../theme.slint";
import { SchoolSelector, SchoolEntry } from "../cmo/school_selector.slint";

export { SchoolEntry }

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    height: 36px;
    background: root.active ? Theme.bg-tertiary :
                (touch.pressed ? Theme.bg-secondary :
                 (touch.has-hover ? Theme.bg-tertiary : transparent));
    border-radius: Theme.radius-md;
    animate background { duration: Theme.duration-fast; easing: ease-in-out; }

    HorizontalLayout {
        padding-left: Theme.space-lg;
        spacing: Theme.space-sm;
        alignment: start;

        Text {
            text: root.label;
            color: root.active ? Theme.accent : (touch.has-hover ? Theme.text : Theme.text-secondary);
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
            overflow: elide;
            animate color { duration: Theme.duration-fast; easing: ease-in-out; }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component NavGroup inherits VerticalLayout {
    in property <string> title;

    spacing: 2px;
    padding-top: Theme.space-md;

    Text {
        text: root.title;
        color: Theme.text-muted;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.5px;
        horizontal-alignment: left;
        x: Theme.space-lg;
    }
}

export component Sidebar inherits Rectangle {
    in property <string> active-tab: "dashboard";
    in property <bool> compact: false;
    callback tab-changed(string);

    // WP-E6.2: school selector visible only when user is CMOSuperAdmin.
    // The Rust binding sets `is-cmo-super-admin` based on EduRole detection
    // (per WP-E6.1) and populates `cmo-schools` from a service that queries
    // InstitutionTreeV1.getCmoSchools (or returns an empty list pre-wiring).
    in property <bool> is-cmo-super-admin: false;
    // WP-E6.6.1 — externally-controlled selector-open state. The banner's
    // Switch button (in app.slint) writes true here; the sidebar's
    // SchoolSelector binds to this so it pops open programmatically.
    in-out property <bool> cmo-selector-open: false;
    in property <[SchoolEntry]> cmo-schools;
    in-out property <string> cmo-active-school-id;
    in-out property <string> cmo-active-school-name;
    callback cmo-school-selected(string);

    // In compact mode, expand on hover (with smooth animation)
    property <bool> hovered: sidebar-hover.has-hover;
    width: root.compact ? (root.hovered ? Theme.sidebar-width : Theme.sidebar-collapsed) : Theme.sidebar-width;
    background: Theme.bg-secondary;
    border-width: 0px;
    animate width { duration: Theme.duration-slow; easing: ease-in-out; }

    sidebar-hover := TouchArea {}

    VerticalLayout {
        padding: Theme.space-sm;
        spacing: 0px;
        alignment: start;

        // Logo + brand
        Rectangle {
            height: 52px;
            HorizontalLayout {
                padding-left: Theme.space-md;
                spacing: Theme.space-sm;
                alignment: start;

                Image {
                    source: @image-url("../../assets/images/citrate-icon.png");
                    width: 28px;
                    height: 28px;
                    image-fit: contain;
                    y: 12px;
                }

                Text {
                    text: "Citrate";
                    color: Theme.accent;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }

        // WP-E6.2 — School selector for CMOSuperAdmin. Sidebar reserves
        // ~56px of height when visible; `if` block ensures non-CMO users
        // don't see it AND don't pay the layout cost.
        if root.is-cmo-super-admin: Rectangle {
            height: 64px;
            HorizontalLayout {
                padding-left: Theme.space-sm;
                padding-right: Theme.space-sm;
                padding-top: Theme.space-xs;
                padding-bottom: Theme.space-xs;

                SchoolSelector {
                    schools: root.cmo-schools;
                    active-school-id <=> root.cmo-active-school-id;
                    active-school-name <=> root.cmo-active-school-name;
                    open <=> root.cmo-selector-open;
                    school-selected(id) => { root.cmo-school-selected(id); }
                }
            }
        }

        // WP-E6 — CMO group; visible only when role == CMOSuperAdmin.
        // The 3 panels (Dashboard / Tenancy / Compliance) are all
        // CMO-scope. E6.3 ships Dashboard; E6.4/E6.5 add the other two.
        if root.is-cmo-super-admin: NavGroup {
            title: "CMO";
            NavItem { label: "Dashboard"; active: root.active-tab == "cmo_dashboard"; clicked => { root.tab-changed("cmo_dashboard"); } }
            NavItem { label: "Tenancy"; active: root.active-tab == "cmo_tenancy"; clicked => { root.tab-changed("cmo_tenancy"); } }
            NavItem { label: "Compliance"; active: root.active-tab == "cmo_compliance"; clicked => { root.tab-changed("cmo_compliance"); } }
        }

        // Blockchain group
        NavGroup {
            title: "BLOCKCHAIN";
            NavItem { label: "Dashboard"; active: root.active-tab == "dashboard"; clicked => { root.tab-changed("dashboard"); } }
            NavItem { label: "Wallet"; active: root.active-tab == "wallet"; clicked => { root.tab-changed("wallet"); } }
            NavItem { label: "DAG Explorer"; active: root.active-tab == "dag"; clicked => { root.tab-changed("dag"); } }
        }

        // AI group
        NavGroup {
            title: "AI";
            NavItem { label: "Chat"; active: root.active-tab == "chat"; clicked => { root.tab-changed("chat"); } }
            NavItem { label: "Models"; active: root.active-tab == "models"; clicked => { root.tab-changed("models"); } }
        }

        // Developer group
        NavGroup {
            title: "DEVELOPER";
            NavItem { label: "Compute"; active: root.active-tab == "compute"; clicked => { root.tab-changed("compute"); } }
            NavItem { label: "Files"; active: root.active-tab == "storage"; clicked => { root.tab-changed("storage"); } }
        }

        // Learning group
        NavGroup {
            title: "LEARNING";
            NavItem { label: "Learn"; active: root.active-tab == "learning"; clicked => { root.tab-changed("learning"); } }
        }

        // Operations group
        NavGroup {
            title: "OPERATIONS";
            NavItem { label: "Agent Center"; active: root.active-tab == "operations"; clicked => { root.tab-changed("operations"); } }
        }

        // BFR-INT-1 — Boeing (FedRAMP / inter-org) panels. Routes are
        // visible to every contributor for now; gate to a federated-
        // role check once RoleEscalation wiring lands in BFR-INT-2.
        NavGroup {
            title: "BOEING";
            NavItem { label: "Overview"; active: root.active-tab == "boeing_overview"; clicked => { root.tab-changed("boeing_overview"); } }
            NavItem { label: "Provenance"; active: root.active-tab == "boeing_provenance"; clicked => { root.tab-changed("boeing_provenance"); } }
            NavItem { label: "Suppliers"; active: root.active-tab == "boeing_suppliers"; clicked => { root.tab-changed("boeing_suppliers"); } }
            NavItem { label: "Federated Learning"; active: root.active-tab == "boeing_fl"; clicked => { root.tab-changed("boeing_fl"); } }
            NavItem { label: "Models & Compute"; active: root.active-tab == "boeing_models_compute"; clicked => { root.tab-changed("boeing_models_compute"); } }
            NavItem { label: "Apps & Contracts"; active: root.active-tab == "boeing_apps_contracts"; clicked => { root.tab-changed("boeing_apps_contracts"); } }
            NavItem { label: "Assistant Logs"; active: root.active-tab == "boeing_assistant_logs"; clicked => { root.tab-changed("boeing_assistant_logs"); } }
            NavItem { label: "Assistant Pane"; active: root.active-tab == "boeing_assistant_pane"; clicked => { root.tab-changed("boeing_assistant_pane"); } }
            NavItem { label: "Governance"; active: root.active-tab == "boeing_governance"; clicked => { root.tab-changed("boeing_governance"); } }
            NavItem { label: "Ontology"; active: root.active-tab == "boeing_ontology"; clicked => { root.tab-changed("boeing_ontology"); } }
        }

        // Spacer
        Rectangle { vertical-stretch: 1; }

        // Settings at bottom
        NavItem { label: "Settings"; active: root.active-tab == "settings"; clicked => { root.tab-changed("settings"); } }
    }
}
