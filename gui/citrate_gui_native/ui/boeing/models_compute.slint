// citrate_gui_native / ui/boeing/models_compute.slint
//
// BFR-08 WP-3 — Models & Compute panel. 1:1 fidelity per
// `06_FIDELITY_MATRIX.md` (Models & Compute panel row); composes BFR-01
// kit primitives + BFR-03 layout shell tokens.
//
// State-bearing surfaces and the TLA+ specs that govern them
// (WP-2 citation matrix; see WP_02_TLA_CITATIONS.md):
//   - Model list & browse  -> gui/ModelRegistryFlow.tla
//   - Publish flow         -> gui/ModelPublishVerificationLifecycle.tla
//   - Artifact identity    -> contracts/ModelArtifactIdentity.tla
//   - On-chain commitment  -> consensus/EmbeddedModelCommitment.tla
//   - Compute jobs         -> compute/ComputeMarketplaceLifecycle.tla
//   - TEE attestation      -> compute/ComputeVerification.tla (TEE tier)
//
// Data sources (chain 40204; per WP-4 bindings):
//   - boeing-models-list(scope, page)         -> ModelRegistry.getAllModelHashes() + getModelsInfo(...)
//   - boeing-compute-jobs(scope)              -> ComputeMarketplace.activeJobs(scope)
//   - boeing-compute-attestation(job_id)      -> TEEAttestationRegistry.byJob(job_id)
//   - boeing-models-publish(...)              -> ModelRegistry.registerModel(...)
//
// Planset deviation flagged in WP-2: planset said publish -> publish();
// actual contract function is registerModel(). Bindings adapter (WP-5)
// uses registerModel; UI label remains "Publish".

import { Tokens } from "../../../citrate_boeing_kit/ui/tokens.slint";
import { DataTable, DataTableRow } from "../../../citrate_boeing_kit/ui/data_table.slint";
import { KpiTile, BoeingTrendKind } from "../../../citrate_boeing_kit/ui/kpi_tile.slint";

component Card inherits Rectangle {
    background: Tokens.surface;
    border-width: 1px;
    border-color: Tokens.border;
    border-radius: Tokens.r-md;
    drop-shadow-blur: 4px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: rgba(0, 0, 0, 0.25);
}

component CardHead inherits Rectangle {
    in property <string> title-text;
    in property <string> meta-text;
    height: 44px;
    background: transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: stretch;
        Text {
            text: root.title-text;
            color: Tokens.text;
            font-family: Tokens.font-sans;
            font-size: Tokens.fs-14;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle { background: transparent; }
        Text {
            text: root.meta-text;
            color: Tokens.text-3;
            font-family: Tokens.font-mono;
            font-size: Tokens.fs-11;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Tokens.border;
    }
}

export component ModelsComputePanel inherits Rectangle {
    // Scope header
    in property <string> focused-scope-text: "—";

    // KPI strip
    in property <string> total-models-text: "0";
    in property <string> active-jobs-text: "0";
    in property <string> attested-jobs-text: "0";

    // Tables — typed as the kit's generic DataTableRow so the panel
    // remains decoupled from the bindings layer (WP-4 supplies these).
    in property <[DataTableRow]> model-rows;
    in property <[DataTableRow]> job-rows;

    // Callbacks consumed by the host (WP-6 wires them to IPC commands).
    callback model-row-clicked(int);
    callback job-row-clicked(int);
    callback publish-clicked();

    background: Tokens.bg;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // KPI strip — Total models / Active jobs / Attested jobs
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: stretch;
                KpiTile {
                    label-text: "MODELS IN SCOPE";
                    value-text: root.total-models-text;
                    trend-text: "";
                    trend-kind: BoeingTrendKind.neutral;
                    sub-tail: "registered";
                }
            }
            VerticalLayout {
                alignment: stretch;
                KpiTile {
                    label-text: "ACTIVE COMPUTE JOBS";
                    value-text: root.active-jobs-text;
                    trend-text: "";
                    trend-kind: BoeingTrendKind.success;
                    sub-tail: "executing or verifying";
                }
            }
            VerticalLayout {
                alignment: stretch;
                KpiTile {
                    label-text: "TEE-ATTESTED";
                    value-text: root.attested-jobs-text;
                    trend-text: "";
                    trend-kind: BoeingTrendKind.success;
                    sub-tail: "hardware-rooted";
                }
            }
        }

        // Scope + Publish header
        Card {
            height: 60px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 24px;
                alignment: stretch;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "SCOPE";
                        color: Tokens.text-4;
                        font-family: Tokens.font-mono;
                        font-size: Tokens.fs-10;
                        letter-spacing: 0.6px;
                    }
                    Text {
                        text: root.focused-scope-text;
                        color: Tokens.text;
                        font-family: Tokens.font-mono;
                        font-size: Tokens.fs-14;
                    }
                }
                Rectangle { background: transparent; }
                VerticalLayout {
                    alignment: center;
                    publish-touch := TouchArea {
                        width: 132px;
                        height: 32px;
                        clicked => { root.publish-clicked(); }
                        Rectangle {
                            background: publish-touch.has-hover ? Tokens.accent-hover : Tokens.accent;
                            border-radius: Tokens.r-sm;
                            Text {
                                text: "Publish model";
                                color: #FFFFFF;
                                font-family: Tokens.font-sans;
                                font-size: Tokens.fs-12;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Model registry list
        Card {
            VerticalLayout {
                CardHead {
                    title-text: "Model registry";
                    meta-text: "ModelRegistry.getAllModelHashes()";
                }
                VerticalLayout {
                    padding: 12px;
                    DataTable {
                        h1: "Hash";
                        h2: "Name";
                        h3: "State";
                        h4: "Owner";
                        h5: "Revenue";
                        rows: root.model-rows;
                        row-clicked(i) => { root.model-row-clicked(i); }
                    }
                }
            }
        }

        // Compute jobs queue
        Card {
            VerticalLayout {
                CardHead {
                    title-text: "Active compute jobs";
                    meta-text: "ComputeMarketplace.activeJobs(scope)";
                }
                VerticalLayout {
                    padding: 12px;
                    DataTable {
                        h1: "Job";
                        h2: "Model";
                        h3: "State";
                        h4: "Provider";
                        h5: "Attestation";
                        rows: root.job-rows;
                        row-clicked(i) => { root.job-row-clicked(i); }
                    }
                }
            }
        }
    }
}
