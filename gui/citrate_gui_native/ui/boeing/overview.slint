// citrate_gui_native / ui/boeing/overview.slint
//
// BFR-04 — Overview panel. Composes BFR-01 kit primitives into the
// prototype's Overview screen. 1:1 fidelity per
// `.agentile/planset/2026-05-07-boeing-fedramp-slint-rebuild/06_FIDELITY_MATRIX.md`
// row 1: prototype/app.jsx:339-456 + styles.css `.kpi-grid` +
// `.col-60-40` + `.card` + `.card-head`.
//
// Layout:
//
//   ┌────────────────────────────────────────────────────────────┐
//   │ KpiTile │ KpiTile │ KpiTile          (3-col, 12px gap)     │
//   ├────────────────────────────────────────────────────────────┤
//   │ AuditEventRibbon (12 events · last 24h)                    │
//   ├────────────────────────────────────────────────────────────┤
//   │ Recent decisions (60%)         │ Compliance posture (40%) │
//   │  - DecisionCard × 6            │  - ComplianceRow × 4     │
//   │  - CapacityBoundProgress       │ Auto-revocations         │
//   │                                │  - RevocationRow × 3     │
//   └────────────────────────────────────────────────────────────┘
//
// State machine: this panel does NOT directly own state — the
// AppShell host crate owns the bindings calls and feeds typed data
// into the property bindings exposed below. The panel is a pure
// render surface.

import { Tokens } from "../../../citrate_boeing_kit/ui/tokens.slint";
import { KpiTile, BoeingTrendKind } from "../../../citrate_boeing_kit/ui/kpi_tile.slint";
import { AuditEventRibbon, AuditEventData } from "../../../citrate_boeing_kit/ui/audit_event_ribbon.slint";
import { DecisionCard, BoeingDecisionStatus } from "../../../citrate_boeing_kit/ui/decision_card.slint";
import { CapacityBoundProgress } from "../../../citrate_boeing_kit/ui/capacity_bound_progress.slint";
import { ComplianceRow } from "../../../citrate_boeing_kit/ui/compliance_row.slint";
import { RevocationRow } from "../../../citrate_boeing_kit/ui/revocation_row.slint";
import { BoeingClassLevel } from "../../../citrate_boeing_kit/ui/class_bar.slint";

// ---------------------------------------------------------------------------
// Per-panel data structs. Each maps directly to a typed payload from
// the citrate-rbac-bindings crate (BFR-03 deliverable). The host
// crate's bindings_adapter module produces these structs from
// `MockRbacBindings` or `LiveRbacBindings`.
// ---------------------------------------------------------------------------

export struct OverviewKpi {
    label: string,
    value: string,
    trend-text: string,
    trend-kind: BoeingTrendKind,
    sub-tail: string,
}

export struct OverviewDecisionRow {
    classification: BoeingClassLevel,
    signer-id: string,
    auth-mode: string,
    auth-color: brush,
    description: string,
    timestamp: string,
    correlation-id: string,
    tx-short: string,
    status: BoeingDecisionStatus,
    flagged: bool,
}

export struct OverviewCompliance {
    name: string,
    percent: float,
    fill-color: brush,
    label: string,
}

export struct OverviewRevocation {
    classification: BoeingClassLevel,
    user-id: string,
    role-text: string,
    reason-text: string,
    timestamp-short: string,
}

// ---------------------------------------------------------------------------
// Card / CardHead — local helpers mirroring the prototype's `.card` +
// `.card-head` CSS rules (styles.css:442-467). Not promoted to the kit
// because the planset doesn't enumerate a generic Card primitive; if
// other panels reuse this pattern, BFR-12 can promote.
// ---------------------------------------------------------------------------

component Card inherits Rectangle {
    background: Tokens.surface;
    border-width: 1px;
    border-color: Tokens.border;
    border-radius: Tokens.r-md;
    drop-shadow-blur: 4px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: rgba(0, 0, 0, 0.25);
}

component CardHead inherits Rectangle {
    in property <string> title-text;
    in property <string> meta-text;
    height: 44px;
    background: transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: stretch;
        Text {
            text: root.title-text;
            color: Tokens.text;
            font-family: Tokens.font-sans;
            font-size: Tokens.fs-14;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle { background: transparent; }
        Text {
            text: root.meta-text;
            color: Tokens.text-3;
            font-family: Tokens.font-mono;
            font-size: Tokens.fs-11;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    // 1px bottom border per .card-head { border-bottom }.
    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Tokens.border;
    }
}

// ---------------------------------------------------------------------------
// OverviewPanel — main composition.
// ---------------------------------------------------------------------------

export component OverviewPanel inherits Rectangle {
    // Per-area data inputs.
    in property <[OverviewKpi]> kpis;
    in property <[AuditEventData]> ribbon-events;
    in property <string> ribbon-highlight-id;
    in property <[OverviewDecisionRow]> decisions;
    in property <string> decisions-meta: "last 24h · 10 of 1,284";
    in property <[OverviewCompliance]> compliance-rows;
    in property <[OverviewRevocation]> revocations;

    // Capacity-bound progress footer of the Recent decisions card.
    in property <string> ledger-label-text: "Decision ledger";
    in property <string> ledger-count-text: "50 of 1,284 entries";
    in property <float> ledger-percent: 0.04;
    in property <string> ledger-percent-text: "page 1 of 26";
    in property <string> ledger-cap-text: "cap: 50/page";

    callback kpi-clicked(int /* kpi index */);
    callback ribbon-event-picked(string /* event id */);
    callback decision-clicked(int /* decision index */);
    callback revocation-clicked(int /* revocation index */);

    background: Tokens.bg;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // ── KPI grid (3 tiles, equal-width, 12px gap) ──────────────
        HorizontalLayout {
            spacing: 12px;
            for kpi[i] in root.kpis: VerticalLayout {
                alignment: stretch;
                KpiTile {
                    label-text: kpi.label;
                    value-text: kpi.value;
                    trend-text: kpi.trend-text;
                    trend-kind: kpi.trend-kind;
                    sub-tail: kpi.sub-tail;
                    clicked => { root.kpi-clicked(i); }
                }
            }
        }

        // ── AuditEventRibbon ──────────────────────────────────────
        AuditEventRibbon {
            events: root.ribbon-events;
            highlight-id: root.ribbon-highlight-id;
            event-picked(id) => { root.ribbon-event-picked(id); }
        }

        // ── 60-40 column split ────────────────────────────────────
        HorizontalLayout {
            spacing: 16px;
            alignment: stretch;

            // Left column — 60% (Recent decisions card)
            Card {
                horizontal-stretch: 3;
                VerticalLayout {
                    spacing: 0;
                    CardHead {
                        title-text: "Recent decisions";
                        meta-text: root.decisions-meta;
                    }
                    // Body: 6 DecisionCard rows
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        for row[i] in root.decisions: DecisionCard {
                            classification: row.classification;
                            signer-id: row.signer-id;
                            auth-mode: row.auth-mode;
                            auth-color: row.auth-color;
                            description: row.description;
                            timestamp: row.timestamp;
                            correlation-id: row.correlation-id;
                            tx-short: row.tx-short;
                            status: row.status;
                            flagged: row.flagged;
                            card-clicked => { root.decision-clicked(i); }
                        }
                    }
                    // Footer: CapacityBoundProgress
                    Rectangle {
                        height: 1px;
                        background: Tokens.border;
                    }
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        CapacityBoundProgress {
                            label-text: root.ledger-label-text;
                            count-text: root.ledger-count-text;
                            percent: root.ledger-percent;
                            percent-text: root.ledger-percent-text;
                            cap-text: root.ledger-cap-text;
                            fill-color: Tokens.info;
                        }
                    }
                }
            }

            // Right column — 40% (Compliance + Auto-revocations stacked)
            VerticalLayout {
                horizontal-stretch: 2;
                spacing: 16px;

                // Compliance posture card
                Card {
                    VerticalLayout {
                        spacing: 0;
                        CardHead {
                            title-text: "Compliance posture";
                            meta-text: "verifiable bundle ready";
                        }
                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 8px;
                            padding-bottom: 12px;
                            for row[i] in root.compliance-rows: ComplianceRow {
                                name-text: row.name;
                                percent: row.percent;
                                fill-color: row.fill-color;
                                label-text: row.label;
                                draw-top-border: i > 0;
                            }
                        }
                    }
                }

                // Auto-revocations card
                Card {
                    VerticalLayout {
                        spacing: 0;
                        CardHead {
                            title-text: "Auto-revocations";
                            meta-text: "last 24h";
                        }
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            for r[i] in root.revocations: RevocationRow {
                                classification: r.classification;
                                user-id: r.user-id;
                                role-text: r.role-text;
                                reason-text: r.reason-text;
                                timestamp-short: r.timestamp-short;
                                row-clicked => { root.revocation-clicked(i); }
                            }
                        }
                    }
                }
            }
        }
    }
}
