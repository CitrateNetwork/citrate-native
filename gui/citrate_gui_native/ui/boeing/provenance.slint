// citrate_gui_native / ui/boeing/provenance.slint
//
// BFR-05b — Provenance panel. Composes BFR-01 kit primitives into the
// prototype's Provenance screen. 1:1 fidelity per
// `06_FIDELITY_MATRIX.md` row 3: prototype/app.jsx:463 — three tabs
// (Configuration / Counterfeit / Search) with lineage tree + tail
// search results.

import { Tokens } from "../../../citrate_boeing_kit/ui/tokens.slint";
import { TabStrip, TabSpec } from "../../../citrate_boeing_kit/ui/tab_strip.slint";
import { LineageTree, LineageNodeData } from "../../../citrate_boeing_kit/ui/lineage_tree.slint";
import { DataTable, DataTableRow } from "../../../citrate_boeing_kit/ui/data_table.slint";
import { Pill, BoeingPillKind } from "../../../citrate_boeing_kit/ui/pill.slint";

export enum ProvenanceVerifyState {
    idle,
    ok,
    failed,
    not-found,
}

component Card inherits Rectangle {
    background: Tokens.surface;
    border-width: 1px;
    border-color: Tokens.border;
    border-radius: Tokens.r-md;
    drop-shadow-blur: 4px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: rgba(0, 0, 0, 0.25);
}

component CardHead inherits Rectangle {
    in property <string> title-text;
    in property <string> meta-text;
    height: 44px;
    background: transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: stretch;
        Text {
            text: root.title-text;
            color: Tokens.text;
            font-family: Tokens.font-sans;
            font-size: Tokens.fs-14;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle { background: transparent; }
        Text {
            text: root.meta-text;
            color: Tokens.text-3;
            font-family: Tokens.font-mono;
            font-size: Tokens.fs-11;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Tokens.border;
    }
}

component VerifyBadge inherits Rectangle {
    in property <ProvenanceVerifyState> state;
    in property <string> status-text;

    height: 28px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        alignment: start;

        Pill {
            kind: state == ProvenanceVerifyState.ok ? BoeingPillKind.success
                : state == ProvenanceVerifyState.failed ? BoeingPillKind.error
                : state == ProvenanceVerifyState.not-found ? BoeingPillKind.warn
                : BoeingPillKind.info;
            label: state == ProvenanceVerifyState.ok ? "VERIFIED"
                : state == ProvenanceVerifyState.failed ? "FAILED"
                : state == ProvenanceVerifyState.not-found ? "NOT FOUND"
                : "IDLE";
        }
        Text {
            text: root.status-text;
            color: Tokens.text-3;
            font-family: Tokens.font-mono;
            font-size: Tokens.fs-11;
            vertical-alignment: center;
        }
    }
}

export component ProvenancePanel inherits Rectangle {
    in property <int> active-tab: 0;
    in property <string> focused-part-text: "—";
    in property <string> focused-tail-text: "—";
    in property <[LineageNodeData]> lineage-nodes;
    in property <ProvenanceVerifyState> verify-state: ProvenanceVerifyState.idle;
    in property <string> verify-status-text: "Enter a part hash to verify";
    in property <[DataTableRow]> search-rows;

    callback tab-changed(int);
    callback lineage-node-clicked(int);
    callback search-row-clicked(int);

    background: Tokens.bg;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        TabStrip {
            tabs: [
                { label: "Configuration", count-text: "" },
                { label: "Counterfeit", count-text: "" },
                { label: "Search", count-text: "" },
            ];
            active-index: root.active-tab;
            tab-clicked(i) => { root.tab-changed(i); }
        }

        Card {
            height: 60px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 24px;
                alignment: stretch;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "PART";
                        color: Tokens.text-4;
                        font-family: Tokens.font-mono;
                        font-size: Tokens.fs-10;
                        letter-spacing: 0.6px;
                    }
                    Text {
                        text: root.focused-part-text;
                        color: Tokens.text;
                        font-family: Tokens.font-mono;
                        font-size: Tokens.fs-14;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "TAIL";
                        color: Tokens.text-4;
                        font-family: Tokens.font-mono;
                        font-size: Tokens.fs-10;
                        letter-spacing: 0.6px;
                    }
                    Text {
                        text: root.focused-tail-text == "" ? "—" : root.focused-tail-text;
                        color: Tokens.text;
                        font-family: Tokens.font-mono;
                        font-size: Tokens.fs-14;
                    }
                }
                Rectangle { background: transparent; }
                VerticalLayout {
                    alignment: center;
                    VerifyBadge {
                        state: root.verify-state;
                        status-text: root.verify-status-text;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            alignment: stretch;

            Card {
                horizontal-stretch: 3;
                VerticalLayout {
                    spacing: 0;
                    CardHead {
                        title-text: "Lineage";
                        meta-text: "root → leaf";
                    }
                    Rectangle {
                        background: transparent;
                        VerticalLayout {
                            padding: 12px;
                            LineageTree {
                                nodes: root.lineage-nodes;
                                node-clicked(i) => { root.lineage-node-clicked(i); }
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 2;
                spacing: 16px;

                Card {
                    VerticalLayout {
                        spacing: 0;
                        CardHead {
                            title-text: "Search";
                            meta-text: "tail-number prefix";
                        }
                        VerticalLayout {
                            padding: 12px;
                            DataTable {
                                h1: "Tail";
                                h2: "Parts";
                                h3: "Display";
                                h4: "";
                                h5: "";
                                rows: root.search-rows;
                                row-clicked(i) => { root.search-row-clicked(i); }
                            }
                        }
                    }
                }
            }
        }
    }
}
