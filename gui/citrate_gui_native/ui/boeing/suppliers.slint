// citrate_gui_native / ui/boeing/suppliers.slint
//
// BFR-06b — Suppliers panel. Composes BFR-01 kit primitives into the
// prototype's Suppliers screen. 1:1 fidelity per
// `06_FIDELITY_MATRIX.md` row 4 (prototype/app.jsx:696).

import { Tokens } from "../../../citrate_boeing_kit/ui/tokens.slint";
import { TabStrip, TabSpec } from "../../../citrate_boeing_kit/ui/tab_strip.slint";
import { DataTable, DataTableRow } from "../../../citrate_boeing_kit/ui/data_table.slint";

component Card inherits Rectangle {
    background: Tokens.surface;
    border-width: 1px;
    border-color: Tokens.border;
    border-radius: Tokens.r-md;
    drop-shadow-blur: 4px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: rgba(0, 0, 0, 0.25);
}

component CardHead inherits Rectangle {
    in property <string> title-text;
    in property <string> meta-text;
    height: 44px;
    background: transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: stretch;
        Text {
            text: root.title-text;
            color: Tokens.text;
            font-family: Tokens.font-sans;
            font-size: Tokens.fs-14;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle { background: transparent; }
        Text {
            text: root.meta-text;
            color: Tokens.text-3;
            font-family: Tokens.font-mono;
            font-size: Tokens.fs-11;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Tokens.border;
    }
}

export component SuppliersPanel inherits Rectangle {
    in property <int> active-tab: 0; // 0=Network, 1=Queue, 2=MOQ
    in property <string> focused-scope-text: "—";
    in property <string> focused-program-text: "—";
    in property <[DataTableRow]> network-rows;
    in property <[DataTableRow]> queue-rows;
    in property <[DataTableRow]> moq-rows;

    callback tab-changed(int);
    callback network-row-clicked(int);
    callback queue-row-clicked(int);
    callback moq-row-clicked(int);

    background: Tokens.bg;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        TabStrip {
            tabs: [
                { label: "Network", count: 0, show-count: false },
                { label: "Qualification queue", count: 0, show-count: false },
                { label: "MOQ tracking", count: 0, show-count: false },
            ];
            active-index: root.active-tab;
            tab-clicked(i) => { root.tab-changed(i); }
        }

        Card {
            height: 60px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 24px;
                alignment: stretch;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "SCOPE";
                        color: Tokens.text-4;
                        font-family: Tokens.font-mono;
                        font-size: Tokens.fs-10;
                        letter-spacing: 0.6px;
                    }
                    Text {
                        text: root.focused-scope-text;
                        color: Tokens.text;
                        font-family: Tokens.font-mono;
                        font-size: Tokens.fs-14;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "PROGRAM";
                        color: Tokens.text-4;
                        font-family: Tokens.font-mono;
                        font-size: Tokens.fs-10;
                        letter-spacing: 0.6px;
                    }
                    Text {
                        text: root.focused-program-text;
                        color: Tokens.text;
                        font-family: Tokens.font-mono;
                        font-size: Tokens.fs-14;
                    }
                }
                Rectangle { background: transparent; }
            }
        }

        if root.active-tab == 0: Card {
            VerticalLayout {
                CardHead {
                    title-text: "Supplier network";
                    meta-text: "all qualified + in-review";
                }
                VerticalLayout {
                    padding: 12px;
                    DataTable {
                        h1: "Supplier";
                        h2: "Name";
                        h3: "State";
                        h4: "Registered";
                        h5: "Days remaining";
                        rows: root.network-rows;
                        row-clicked(i) => { root.network-row-clicked(i); }
                    }
                }
            }
        }

        if root.active-tab == 1: Card {
            VerticalLayout {
                CardHead {
                    title-text: "Qualification queue";
                    meta-text: "pending + in-review";
                }
                VerticalLayout {
                    padding: 12px;
                    DataTable {
                        h1: "Supplier";
                        h2: "Name";
                        h3: "State";
                        h4: "Registered";
                        h5: "Days remaining";
                        rows: root.queue-rows;
                        row-clicked(i) => { root.queue-row-clicked(i); }
                    }
                }
            }
        }

        if root.active-tab == 2: Card {
            VerticalLayout {
                CardHead {
                    title-text: "MOQ tracking";
                    meta-text: "current period";
                }
                VerticalLayout {
                    padding: 12px;
                    DataTable {
                        h1: "Commitment";
                        h2: "Supplier";
                        h3: "Part family";
                        h4: "Belnap";
                        h5: "Variance";
                        rows: root.moq-rows;
                        row-clicked(i) => { root.moq-row-clicked(i); }
                    }
                }
            }
        }
    }
}
