// citrate_gui_native / ui/boeing/assistant_logs.slint
//
// BFR-10 WP-5 — Assistant Logs panel. 1:1 fidelity per
// `06_FIDELITY_MATRIX.md` row 8 (prototype/app.jsx:1451); composes
// BFR-01 kit primitives + BFR-03 layout shell tokens.
//
// State-bearing surfaces and the TLA+ specs that govern them
// (per WP-2 citation matrix in TLA_CITATION_MATRIX.md):
//   - Decision-log append-only → contracts/AgentDecisionLog.tla
//   - Anchor session modal     → gui/ModalLifecycle.tla
//   - Decision detail drawer   → gui/DrawerLifecycle.tla
//
// Data sources (chain 40204; per WP-4 bindings + WP-6 IPC):
//   - boeing-assist-decisions(corr_id)
//          -> AgentDecisionRegistryV2.byCorrId(corr_id) (existing)
//   - boeing-assist-history(session_id)
//          -> local store + AuditBundleRegistry.anchorSession(...) (new)
//   - boeing-assist-replay(session_id)
//          -> bundle generator + AuditBundleRegistry.anchor(kind=2, ...)
//
// Planset note: this panel renders the rich decision log surface as
// a full-page view; the slide-in `assistant_pane.slint` provides the
// in-context "Ask about this" UX.

import { Tokens } from "../../../citrate_boeing_kit/ui/tokens.slint";
import { DataTable, DataTableRow } from "../../../citrate_boeing_kit/ui/data_table.slint";
import { KpiTile, BoeingTrendKind } from "../../../citrate_boeing_kit/ui/kpi_tile.slint";

component Card inherits Rectangle {
    background: Tokens.surface;
    border-width: 1px;
    border-color: Tokens.border;
    border-radius: Tokens.r-md;
    drop-shadow-blur: 4px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: rgba(0, 0, 0, 0.25);
}

component CardHead inherits Rectangle {
    in property <string> title-text;
    in property <string> meta-text;
    height: 44px;
    background: transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: stretch;
        Text {
            text: root.title-text;
            color: Tokens.text;
            font-family: Tokens.font-sans;
            font-size: Tokens.fs-14;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle { background: transparent; }
        Text {
            text: root.meta-text;
            color: Tokens.text-3;
            font-family: Tokens.font-mono;
            font-size: Tokens.fs-11;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Tokens.border;
    }
}

export component AssistantLogsPanel inherits Rectangle {
    // Scope header
    in property <string> focused-scope-text: "—";

    // KPI strip
    in property <string> sessions-today-text: "0";
    in property <string> pending-tool-calls-text: "0";
    in property <string> decisions-recorded-text: "0";
    in property <string> bundles-anchored-text: "0";

    // Tables — typed as the kit's generic DataTableRow so the panel
    // remains decoupled from the bindings layer (WP-4/6 supplies these).
    in property <[DataTableRow]> decision-rows;
    in property <[DataTableRow]> bundle-rows;

    // Callbacks consumed by the host (WP-6 wires them to IPC commands).
    callback decision-row-clicked(int);
    callback bundle-row-clicked(int);
    callback anchor-session-clicked();

    background: Tokens.bg;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // KPI strip — 4 tiles
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: stretch;
                KpiTile {
                    label-text: "SESSIONS TODAY";
                    value-text: root.sessions-today-text;
                    trend-text: "";
                    trend-kind: BoeingTrendKind.neutral;
                    sub-tail: "assistant pane";
                }
            }
            VerticalLayout {
                alignment: stretch;
                KpiTile {
                    label-text: "PENDING TOOL CALLS";
                    value-text: root.pending-tool-calls-text;
                    trend-text: "";
                    trend-kind: BoeingTrendKind.warn;
                    sub-tail: "awaiting approval";
                }
            }
            VerticalLayout {
                alignment: stretch;
                KpiTile {
                    label-text: "DECISIONS RECORDED";
                    value-text: root.decisions-recorded-text;
                    trend-text: "";
                    trend-kind: BoeingTrendKind.success;
                    sub-tail: "append-only";
                }
            }
            VerticalLayout {
                alignment: stretch;
                KpiTile {
                    label-text: "BUNDLES ANCHORED";
                    value-text: root.bundles-anchored-text;
                    trend-text: "";
                    trend-kind: BoeingTrendKind.neutral;
                    sub-tail: "audit-grade";
                }
            }
        }

        // Scope + Anchor button header
        Card {
            height: 60px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 24px;
                alignment: stretch;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "SCOPE";
                        color: Tokens.text-4;
                        font-family: Tokens.font-mono;
                        font-size: Tokens.fs-10;
                        letter-spacing: 0.6px;
                    }
                    Text {
                        text: root.focused-scope-text;
                        color: Tokens.text;
                        font-family: Tokens.font-mono;
                        font-size: Tokens.fs-14;
                    }
                }
                Rectangle { background: transparent; }
                VerticalLayout {
                    alignment: center;
                    anchor-touch := TouchArea {
                        width: 148px;
                        height: 32px;
                        clicked => { root.anchor-session-clicked(); }
                        Rectangle {
                            background: anchor-touch.has-hover ? Tokens.accent-hover : Tokens.accent;
                            border-radius: Tokens.r-sm;
                            Text {
                                text: "Anchor session";
                                color: #FFFFFF;
                                font-family: Tokens.font-sans;
                                font-size: Tokens.fs-12;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Decision log grid
        Card {
            VerticalLayout {
                CardHead {
                    title-text: "Decision log";
                    meta-text: "AgentDecisionRegistryV2.latestByTenant(scope, 50) · append-only";
                }
                VerticalLayout {
                    padding: 12px;
                    DataTable {
                        h1: "Decision";
                        h2: "Class";
                        h3: "CorrId";
                        h4: "User";
                        h5: "Block";
                        rows: root.decision-rows;
                        row-clicked(i) => { root.decision-row-clicked(i); }
                    }
                }
            }
        }

        // Bundle history
        Card {
            VerticalLayout {
                CardHead {
                    title-text: "Anchored bundles";
                    meta-text: "AuditBundleRegistry.bundlesByScopeList(scope) · IPFS-pinned";
                }
                VerticalLayout {
                    padding: 12px;
                    DataTable {
                        h1: "Bundle";
                        h2: "Session";
                        h3: "Kind";
                        h4: "Entries";
                        h5: "Block";
                        rows: root.bundle-rows;
                        row-clicked(i) => { root.bundle-row-clicked(i); }
                    }
                }
            }
        }
    }
}
