// citrate_gui_native / ui/boeing/federated_learning.slint
//
// BFR-07b — Federated Learning panel. 1:1 fidelity per
// `06_FIDELITY_MATRIX.md` row 5 (prototype/app.jsx:887).

import { Tokens } from "../../../citrate_boeing_kit/ui/tokens.slint";
import { DataTable, DataTableRow } from "../../../citrate_boeing_kit/ui/data_table.slint";
import { KpiTile, BoeingTrendKind } from "../../../citrate_boeing_kit/ui/kpi_tile.slint";

component Card inherits Rectangle {
    background: Tokens.surface;
    border-width: 1px;
    border-color: Tokens.border;
    border-radius: Tokens.r-md;
    drop-shadow-blur: 4px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: rgba(0, 0, 0, 0.25);
}

component CardHead inherits Rectangle {
    in property <string> title-text;
    in property <string> meta-text;
    height: 44px;
    background: transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: stretch;
        Text {
            text: root.title-text;
            color: Tokens.text;
            font-family: Tokens.font-sans;
            font-size: Tokens.fs-14;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle { background: transparent; }
        Text {
            text: root.meta-text;
            color: Tokens.text-3;
            font-family: Tokens.font-mono;
            font-size: Tokens.fs-11;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Tokens.border;
    }
}

export component FederatedLearningPanel inherits Rectangle {
    in property <string> focused-scope-text: "—";
    in property <[DataTableRow]> pool-rows;
    in property <string> active-cycle-text: "0";
    in property <string> active_count_text: "0";
    in property <string> closed_count_text: "0";

    callback pool-row-clicked(int);

    background: Tokens.bg;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // KPI strip — Active cycle / Active / Total pools
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: stretch;
                KpiTile {
                    label-text: "CYCLES RUNNING";
                    value-text: root.active-cycle-text;
                    trend-text: "";
                    trend-kind: BoeingTrendKind.success;
                    sub-tail: "live training";
                }
            }
            VerticalLayout {
                alignment: stretch;
                KpiTile {
                    label-text: "ACTIVE POOLS";
                    value-text: root.active_count_text;
                    trend-text: "";
                    trend-kind: BoeingTrendKind.neutral;
                    sub-tail: "accepting members";
                }
            }
            VerticalLayout {
                alignment: stretch;
                KpiTile {
                    label-text: "CLOSED POOLS";
                    value-text: root.closed_count_text;
                    trend-text: "";
                    trend-kind: BoeingTrendKind.neutral;
                    sub-tail: "finalized";
                }
            }
        }

        // Focus header
        Card {
            height: 60px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 24px;
                alignment: stretch;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "SCOPE";
                        color: Tokens.text-4;
                        font-family: Tokens.font-mono;
                        font-size: Tokens.fs-10;
                        letter-spacing: 0.6px;
                    }
                    Text {
                        text: root.focused-scope-text;
                        color: Tokens.text;
                        font-family: Tokens.font-mono;
                        font-size: Tokens.fs-14;
                    }
                }
                Rectangle { background: transparent; }
            }
        }

        // Pool list
        Card {
            VerticalLayout {
                CardHead {
                    title-text: "Federated learning pools";
                    meta-text: "scope-tagged via BoeingFLScopeIndex";
                }
                VerticalLayout {
                    padding: 12px;
                    DataTable {
                        h1: "Pool";
                        h2: "Name";
                        h3: "State";
                        h4: "Members";
                        h5: "Min stake";
                        rows: root.pool-rows;
                        row-clicked(i) => { root.pool-row-clicked(i); }
                    }
                }
            }
        }
    }
}
