// Learning Center — pools, staking, earnings (P960-I rebuild).
//
// All values come from real chain reads on the canonical contracts:
//   - LearningPool.nextPoolId()        → pool-count
//   - LearningPool.isMember(poolId,me) → is-member
//   - LearningPool.stakes(poolId,me)   → staked-amount
//   - ContributionAccounting.claimable(me) → total-earnings
//
// All actions transact via the in-app wallet:
//   - Join Pool      → LearningPool.joinPool(poolId) payable 1000 SALT
//   - Leave Pool     → LearningPool.leavePool(poolId) (returns stake)
//   - Claim Earnings → ContributionAccounting.claimRewards()
//
// Buttons surface only when the contract state makes them valid:
// "Join" only if there's a pool and you're not already in. "Leave"
// only if you are. "Claim" only if you have earnings > 0. The panel
// is honest about whether the marketplace contract is reachable.
import { Theme } from "../theme.slint";

export component LearningView inherits Rectangle {
    // Read from chain (set by the polling loop in main.rs)
    in property <string> staked-amount: "0";       // user's stake in the current pool, formatted SALT
    in property <string> total-earnings: "0";      // claimable from ContributionAccounting, formatted SALT
    in property <int>    pool-count: 0;            // LearningPool.nextPoolId()
    in property <string> pool-status: "";          // human description (e.g. "Pool #0 · 3 members")
    in property <int>    peer-count: 0;
    in property <int>    current-epoch: 0;
    in property <string> contract-status: "Checking…";
    in property <bool>   is-member: false;
    in-out property <int> current-pool-id: 0;      // pool the buttons act on (default 0)
    // T2-8: Pool detail fields — populated by the polling loop when
    // the current pool exists. Empty strings mean "no data yet /
    // pool doesn't exist". State/access are human-readable strings
    // derived Rust-side (the enum integers don't mean anything to
    // the user).
    in property <string> pool-name: "";
    in property <string> pool-description: "";
    in property <string> pool-creator: "";
    in property <string> pool-state-label: "";
    in property <string> pool-access-label: "";
    in property <string> pool-min-stake: "";
    in property <int>    pool-member-count: 0;
    in property <string> pool-created-ago: "";

    callback join-pool;
    callback leave-pool;
    callback claim-earnings;
    // T2-9: open the create-pool modal. Modal lives at the App
    // level so it can overlay the whole window.
    callback open-create-pool;

    background: Theme.bg;

    Flickable {
        VerticalLayout {
            padding: Theme.space-lg;
            spacing: Theme.space-lg;

            // ── Header ─────────────────────────────────────────────
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Learning Center";
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                // Contract status pill — green when LearningPool is
                // deployed on the active network, amber otherwise.
                Rectangle {
                    width: 140px; height: 22px;
                    border-radius: 11px;
                    background: root.contract-status == "LearningPool live"
                        ? Theme.success.darker(0.3)
                        : Theme.warning.darker(0.3);
                    Text {
                        text: root.contract-status == "LearningPool live"
                            ? "● live · " + root.pool-count + " pools"
                            : "● offline";
                        color: Theme.text;
                        font-size: 10px;
                        font-weight: 600;
                        font-family: Theme.font-mono;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // ── Deploy-status banner — only when contract isn't live ──
            if root.contract-status != "LearningPool live" : Rectangle {
                height: 48px;
                border-radius: Theme.radius-md;
                background: Theme.warning.darker(0.4);
                border-width: 1px;
                border-color: Theme.warning;
                HorizontalLayout {
                    padding: Theme.space-sm;
                    spacing: Theme.space-sm;
                    Text { text: "⚠"; color: Theme.warning; font-size: 18px; vertical-alignment: center; }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text { text: root.contract-status; color: Theme.text; font-size: 11px; font-weight: 600; }
                        Text {
                            text: "Switch to a network where LearningPool is deployed (testnet-beta, chain 40204).";
                            color: Theme.text-secondary; font-size: 10px; wrap: word-wrap;
                        }
                    }
                }
            }

            // ── First-pool empty state ──
            if root.contract-status == "LearningPool live" && root.pool-count == 0 : Rectangle {
                height: 72px;
                border-radius: Theme.radius-md;
                background: Theme.bg-tertiary;
                border-width: 1px;
                border-color: Theme.border;
                HorizontalLayout {
                    padding: Theme.space-sm;
                    spacing: Theme.space-sm;
                    alignment: center;
                    Text { text: "✨"; color: Theme.accent; font-size: 18px; vertical-alignment: center; }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text { text: "No pools created yet"; color: Theme.text; font-size: 12px; font-weight: 600; }
                        Text {
                            text: "Be the first — create a pool with a 1000 SALT minimum stake.";
                            color: Theme.text-muted; font-size: 10px; wrap: word-wrap;
                        }
                    }
                    // T2-9: create-pool CTA. Opens modal at the App level.
                    Rectangle {
                        width: 120px; height: 32px;
                        border-radius: Theme.radius-md;
                        background: cp-ta.has-hover ? Theme.accent-hover : Theme.accent;
                        animate background { duration: 120ms; }
                        Text {
                            text: "Create pool";
                            color: #000000; font-size: 12px; font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        cp-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-create-pool(); }
                        }
                    }
                }
            }

            // ── Stats row ──────────────────────────────────────────
            HorizontalLayout {
                spacing: Theme.space-md;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 80px;
                    border-radius: Theme.radius-lg;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;
                    VerticalLayout {
                        padding: Theme.space-md;
                        spacing: Theme.space-xs;
                        Text { text: "EARNINGS"; color: Theme.text-muted; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; }
                        Text { text: root.total-earnings + " SALT"; color: Theme.success; font-size: 18px; font-weight: 600; overflow: elide; }
                        Text { text: "claimable from ContributionAccounting"; color: Theme.text-muted; font-size: 9px; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 80px;
                    border-radius: Theme.radius-lg;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;
                    VerticalLayout {
                        padding: Theme.space-md;
                        spacing: Theme.space-xs;
                        Text { text: "YOUR STAKE"; color: Theme.text-muted; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; }
                        Text { text: root.staked-amount + " SALT"; color: Theme.accent; font-size: 18px; font-weight: 600; overflow: elide; }
                        Text {
                            text: root.is-member
                                ? "in pool #" + root.current-pool-id
                                : "not in any pool";
                            color: Theme.text-muted; font-size: 9px;
                        }
                    }
                }
            }

            // ── T2-10 pool selector — only when > 1 pool exists ──
            if root.pool-count > 1 : HorizontalLayout {
                spacing: Theme.space-sm;
                Text {
                    text: "Viewing pool:";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 32px; height: 26px;
                    border-radius: Theme.radius-md;
                    background: prev-ta.has-hover && root.current-pool-id > 0
                        ? Theme.bg-tertiary : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    opacity: root.current-pool-id > 0 ? 1.0 : 0.4;
                    Text {
                        text: "<";
                        color: Theme.text;
                        font-size: 14px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    prev-ta := TouchArea {
                        mouse-cursor: pointer;
                        enabled: root.current-pool-id > 0;
                        clicked => {
                            if (root.current-pool-id > 0) {
                                root.current-pool-id = root.current-pool-id - 1;
                            }
                        }
                    }
                }
                Rectangle {
                    width: 80px; height: 26px;
                    border-radius: Theme.radius-md;
                    background: Theme.bg-tertiary;
                    Text {
                        text: "#" + root.current-pool-id + " / " + (root.pool-count - 1);
                        color: Theme.accent;
                        font-size: 11px; font-weight: 600;
                        font-family: Theme.font-mono;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 32px; height: 26px;
                    border-radius: Theme.radius-md;
                    background: next-ta.has-hover && root.current-pool-id < root.pool-count - 1
                        ? Theme.bg-tertiary : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    opacity: root.current-pool-id < root.pool-count - 1 ? 1.0 : 0.4;
                    Text {
                        text: ">";
                        color: Theme.text;
                        font-size: 14px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    next-ta := TouchArea {
                        mouse-cursor: pointer;
                        enabled: root.current-pool-id < root.pool-count - 1;
                        clicked => {
                            if (root.current-pool-id < root.pool-count - 1) {
                                root.current-pool-id = root.current-pool-id + 1;
                            }
                        }
                    }
                }
                Text {
                    text: "buttons below act on this pool";
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            // ── T2-8: Pool detail card — visible when we have a name ──
            if root.pool-name != "" : Rectangle {
                border-radius: Theme.radius-lg;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border-subtle;
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-sm;
                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        Text {
                            text: root.pool-name;
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        // State pill
                        Rectangle {
                            width: 76px; height: 20px;
                            y: 3px;
                            border-radius: 10px;
                            background: root.pool-state-label == "Closed"
                                ? Theme.error.darker(0.3)
                                : Theme.success.darker(0.3);
                            Text {
                                text: root.pool-state-label;
                                color: Theme.text;
                                font-size: 10px; font-weight: 600;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        // Access pill
                        Rectangle {
                            width: 80px; height: 20px;
                            y: 3px;
                            border-radius: 10px;
                            background: Theme.bg-tertiary;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            Text {
                                text: root.pool-access-label;
                                color: Theme.text-secondary;
                                font-size: 10px; font-weight: 600;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                    if root.pool-description != "" : Text {
                        text: root.pool-description;
                        color: Theme.text-secondary;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Theme.space-xl;
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "MEMBERS"; color: Theme.text-muted; font-size: 9px; font-weight: 600; letter-spacing: 0.5px; }
                            Text { text: root.pool-member-count; color: Theme.text; font-size: 13px; font-weight: 600; }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "MIN STAKE"; color: Theme.text-muted; font-size: 9px; font-weight: 600; letter-spacing: 0.5px; }
                            Text { text: root.pool-min-stake + " SALT"; color: Theme.text; font-size: 13px; font-weight: 600; }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: "CREATED"; color: Theme.text-muted; font-size: 9px; font-weight: 600; letter-spacing: 0.5px; }
                            Text { text: root.pool-created-ago; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                        }
                    }
                    if root.pool-creator != "" : HorizontalLayout {
                        spacing: Theme.space-xs;
                        Text { text: "Creator:"; color: Theme.text-muted; font-size: 10px; vertical-alignment: center; }
                        Text {
                            text: root.pool-creator;
                            color: Theme.text-muted;
                            font-size: 10px;
                            font-family: Theme.font-mono;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            // ── Status line ──
            if root.pool-status != "" : Text {
                text: root.pool-status;
                color: Theme.text-secondary;
                font-size: 11px;
                font-family: Theme.font-mono;
            }

            // ── Action buttons — only what's currently valid ──
            HorizontalLayout {
                spacing: Theme.space-sm;

                // Join — visible when contract live, pool exists, not yet member
                if root.contract-status == "LearningPool live" && root.pool-count > 0 && !root.is-member : Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border-radius: Theme.radius-md;
                    background: join-ta.has-hover ? Theme.accent-hover : Theme.accent;
                    animate background { duration: 120ms; }
                    Text {
                        text: "Join pool #" + root.current-pool-id + "  ·  1000 SALT";
                        color: #000000; font-size: 13px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    join-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.join-pool(); }
                    }
                }

                // Leave — visible only when member
                if root.is-member : Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border-radius: Theme.radius-md;
                    background: leave-ta.has-hover ? Theme.error.darker(0.2) : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    animate background { duration: 120ms; }
                    Text {
                        text: "Leave pool — withdraw " + root.staked-amount + " SALT";
                        color: leave-ta.has-hover ? Theme.text : Theme.text-secondary;
                        font-size: 12px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                        overflow: elide;
                    }
                    leave-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.leave-pool(); }
                    }
                }

                // Claim — visible only when there's something to claim
                if root.total-earnings != "0" : Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border-radius: Theme.radius-md;
                    background: claim-ta.has-hover ? Theme.success.darker(0.2) : Theme.success.darker(0.4);
                    border-width: 1px;
                    border-color: Theme.border;
                    animate background { duration: 120ms; }
                    Text {
                        text: "Claim " + root.total-earnings + " SALT";
                        color: Theme.text; font-size: 13px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                        overflow: elide;
                    }
                    claim-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.claim-earnings(); }
                    }
                }
            }

            // ── Network/epoch metadata ──
            HorizontalLayout {
                spacing: Theme.space-md;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 60px;
                    border-radius: Theme.radius-lg;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    VerticalLayout {
                        padding: Theme.space-md;
                        spacing: Theme.space-xs;
                        Text { text: "EPOCH"; color: Theme.text-muted; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; }
                        Text { text: root.current-epoch; color: Theme.text; font-size: 14px; font-weight: 600; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 60px;
                    border-radius: Theme.radius-lg;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    VerticalLayout {
                        padding: Theme.space-md;
                        spacing: Theme.space-xs;
                        Text { text: "PEERS"; color: Theme.text-muted; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; }
                        Text { text: root.peer-count; color: Theme.text; font-size: 14px; font-weight: 600; }
                    }
                }
            }
        }
    }
}
