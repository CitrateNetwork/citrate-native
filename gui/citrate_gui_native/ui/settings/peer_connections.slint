// Section 3: Peer Connections — bootnode management + noise identity
import { Theme } from "@citrate-ui-kit";
import { SectionHeader, ActionButton } from "settings_primitives.slint";

export component PeerConnectionsSection inherits VerticalLayout {
    in property <string> bootnode-list: "";
    in property <string> noise-identity: "";
    in-out property <string> new-bootnode: "";

    callback add-bootnode(string);
    callback remove-bootnode(string);

    spacing: Theme.space-md;

    SectionHeader { text: "Peer Connections"; }

    Text {
        text: "Add bootnodes to connect to other Citrate nodes. Format: noise_<hex>@ip:port";
        color: Theme.text-muted; font-size: 11px;
        wrap: word-wrap;
    }

    // Current bootnode list
    if root.bootnode-list != "" : Rectangle {
        min-height: 36px;
        border-radius: Theme.radius-md;
        background: Theme.bg-secondary;
        border-width: 1px; border-color: Theme.border-subtle;

        HorizontalLayout {
            padding: Theme.space-sm;
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;

            Text {
                text: root.bootnode-list;
                color: Theme.text-muted; font-size: 10px;
                vertical-alignment: center; overflow: elide;
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 50px; height: 24px;
                border-radius: Theme.radius-sm;
                border-width: 1px; border-color: Theme.error;
                Text { text: "Remove"; color: Theme.error; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.remove-bootnode(root.bootnode-list); } }
            }
        }
    }

    // Add input
    HorizontalLayout {
        spacing: Theme.space-sm;

        Rectangle {
            height: 36px; horizontal-stretch: 1;
            border-radius: Theme.radius-md;
            border-width: 1px; border-color: Theme.border;
            background: Theme.bg-secondary;
            TextInput {
                text <=> root.new-bootnode;
                font-size: 11px; color: Theme.text;
                x: Theme.space-md;
                width: parent.width - Theme.space-2xl;
                vertical-alignment: center;
            }
        }

        ActionButton {
            width: 50px;
            label: "Add";
            clicked => { root.add-bootnode(root.new-bootnode); root.new-bootnode = ""; }
        }
    }

    // Noise identity
    if root.noise-identity != "" : VerticalLayout {
        spacing: 2px;
        Text { text: "Noise Identity"; color: Theme.text-secondary; font-size: 10px; }
        Text { text: root.noise-identity; color: Theme.text-muted; font-size: 9px; overflow: elide; }
    }
}
