// Section 10: Danger Zone — factory reset with confirmation step
import { Theme } from "@citrate-ui-kit";

export component DangerZoneSection inherits VerticalLayout {
    callback factory-reset;
    in-out property <bool> show-confirm: false;

    spacing: Theme.space-md;

    Rectangle { height: 1px; background: Theme.error; }

    Text { text: "Danger Zone"; color: Theme.error; font-size: 14px; font-weight: 600; }

    HorizontalLayout {
        alignment: space-between;

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: "Factory Reset"; color: Theme.text; font-size: 13px; }
            Text { text: "Removes all wallets, keys, chain data, and settings. Cannot be undone."; color: Theme.text-muted; font-size: 11px; wrap: word-wrap; }
        }

        if !root.show-confirm : Rectangle {
            height: 32px; width: 110px;
            border-radius: Theme.radius-md;
            border-width: 1px; border-color: Theme.error;
            Text { text: "Reset Everything"; color: Theme.error; font-size: 11px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.show-confirm = true; } }
        }

        if root.show-confirm : HorizontalLayout {
            spacing: Theme.space-sm;

            Rectangle {
                height: 32px; width: 60px;
                border-radius: Theme.radius-md;
                border-width: 1px; border-color: Theme.border;
                Text { text: "Cancel"; color: Theme.text-muted; font-size: 11px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.show-confirm = false; } }
            }

            Rectangle {
                height: 32px; width: 250px;
                border-radius: Theme.radius-md;
                background: Theme.error;
                Text { text: "Confirm Reset — This cannot be undone"; color: #ffffff; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.factory-reset(); root.show-confirm = false; } }
            }
        }
    }
}
