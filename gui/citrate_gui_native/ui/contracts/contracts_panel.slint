// Contracts IDE — Remix-style compile, deploy, interact panel
// Composable: can be embedded in a tab or popped out standalone
import { Theme } from "../theme.slint";

component CompileSection inherits VerticalLayout {
    in property <string> compiler-version: "forge 0.2.0";
    in property <string> compile-status: "Ready";
    in property <bool> compiling: false;
    in property <string> compile-error: "";
    callback compile;

    spacing: Theme.space-sm;

    HorizontalLayout {
        alignment: space-between;
        Text { text: "Solidity Compiler"; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
        Text { text: root.compiler-version; color: Theme.text-muted; font-size: 10px; vertical-alignment: center; }
    }

    Rectangle {
        height: 36px;
        border-radius: Theme.radius-md;
        background: root.compiling ? Theme.bg-tertiary : Theme.sage;

        Text {
            text: root.compiling ? "Compiling..." : "Compile";
            color: root.compiling ? Theme.text-muted : #000000;
            font-size: 12px; font-weight: 600;
            horizontal-alignment: center; vertical-alignment: center;
        }

        TouchArea { clicked => { if !root.compiling { root.compile(); } } }
    }

    Text {
        text: root.compile-status;
        color: root.compile-error != "" ? Theme.error : Theme.success;
        font-size: 11px;
    }

    if root.compile-error != "" : Rectangle {
        min-height: 40px;
        border-radius: Theme.radius-sm;
        background: Theme.bg-tertiary;
        border-width: 1px; border-color: Theme.error;
        clip: true;

        VerticalLayout {
            padding: Theme.space-sm;
            Text {
                text: root.compile-error;
                color: Theme.error;
                font-size: 10px;
                wrap: word-wrap;
            }
        }
    }
}

component DeploySection inherits VerticalLayout {
    in property <string> selected-contract: "";
    in property <string> environment: "Testnet";
    in-out property <string> deploy-account: "";
    in-out property <string> deploy-password: "";
    in property <string> gas-estimate: "";
    in property <bool> deploying: false;
    in property <string> deploy-error: "";
    in property <string> deployed-address: "";
    callback deploy;

    spacing: Theme.space-sm;

    Text { text: "Deploy & Run"; color: Theme.text; font-size: 13px; font-weight: 600; }

    // Environment indicator
    HorizontalLayout {
        spacing: Theme.space-xs;
        Rectangle { width: 8px; height: 8px; border-radius: 4px; y: 4px; background: root.environment == "Devnet" ? Theme.success : (root.environment == "Testnet" ? Theme.warning : Theme.error); }
        Text { text: root.environment; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
    }

    // Contract selector (shows compiled contract name)
    Rectangle {
        height: 32px; border-radius: Theme.radius-md;
        border-width: 1px; border-color: Theme.border;
        background: Theme.bg-secondary;
        clip: true;
        Text {
            text: root.selected-contract != "" ? root.selected-contract : "No contract compiled";
            color: root.selected-contract != "" ? Theme.text : Theme.text-muted;
            font-size: 11px; x: Theme.space-md; vertical-alignment: center;
            overflow: elide;
        }
    }

    // Account input
    VerticalLayout {
        spacing: 2px;
        Text { text: "Account"; color: Theme.text-secondary; font-size: 10px; }
        Rectangle {
            height: 28px; border-radius: Theme.radius-sm;
            border-width: 1px; border-color: Theme.border; background: Theme.bg;
            TextInput {
                text <=> root.deploy-account;
                font-size: 10px; color: Theme.text;
                x: Theme.space-sm; width: parent.width - Theme.space-lg;
                vertical-alignment: center;
            }
        }
    }

    // Password input
    VerticalLayout {
        spacing: 2px;
        Text { text: "Password"; color: Theme.text-secondary; font-size: 10px; }
        Rectangle {
            height: 28px; border-radius: Theme.radius-sm;
            border-width: 1px; border-color: Theme.border; background: Theme.bg;
            TextInput {
                text <=> root.deploy-password;
                font-size: 10px; color: Theme.text;
                x: Theme.space-sm; width: parent.width - Theme.space-lg;
                vertical-alignment: center;
                input-type: password;
            }
        }
    }

    // Gas estimate
    if root.gas-estimate != "" : HorizontalLayout {
        alignment: space-between;
        Text { text: "Gas Estimate"; color: Theme.text-muted; font-size: 10px; }
        Text { text: root.gas-estimate; color: Theme.text; font-size: 10px; }
    }

    // Deploy button
    Rectangle {
        height: 36px; border-radius: Theme.radius-md;
        background: root.deploying ? Theme.bg-tertiary : Theme.accent;
        opacity: root.selected-contract == "" ? 0.5 : 1.0;

        Text {
            text: root.deploying ? "Deploying..." : "Deploy";
            color: root.deploying ? Theme.text-muted : #000000;
            font-size: 12px; font-weight: 600;
            horizontal-alignment: center; vertical-alignment: center;
        }

        TouchArea { clicked => { if !root.deploying && root.selected-contract != "" { root.deploy(); } } }
    }

    // Deploy result
    if root.deployed-address != "" : Rectangle {
        min-height: 32px; border-radius: Theme.radius-sm;
        background: Theme.bg-tertiary; border-width: 1px; border-color: Theme.success;

        VerticalLayout {
            padding: Theme.space-sm;
            Text { text: "Deployed at:"; color: Theme.success; font-size: 10px; }
            Text { text: root.deployed-address; color: Theme.text; font-size: 10px; overflow: elide; }
        }
    }

    if root.deploy-error != "" : Text { text: root.deploy-error; color: Theme.error; font-size: 10px; }
}

export component ContractsPanel inherits Rectangle {
    in property <string> compiler-version: "forge 0.2.0";
    in property <string> compile-status: "Ready";
    in property <bool> compiling: false;
    in property <string> compile-error: "";
    in property <string> selected-contract: "";
    in property <string> environment: "Testnet";
    in property <string> gas-estimate: "";
    in property <bool> deploying: false;
    in property <string> deploy-error: "";
    in property <string> deployed-address: "";

    callback compile;
    callback deploy;

    background: Theme.bg;

    HorizontalLayout {
        // Deploy panel (right side, 300px) — shown as sidebar
        Rectangle {
            width: 300px;
            background: Theme.bg-secondary;
            border-width: 1px;
            border-color: Theme.border-subtle;

            Flickable {
                VerticalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-xl;

                    CompileSection {
                        compiler-version: root.compiler-version;
                        compile-status: root.compile-status;
                        compiling: root.compiling;
                        compile-error: root.compile-error;
                        compile => { root.compile(); }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    DeploySection {
                        selected-contract: root.selected-contract;
                        environment: root.environment;
                        gas-estimate: root.gas-estimate;
                        deploying: root.deploying;
                        deploy-error: root.deploy-error;
                        deployed-address: root.deployed-address;
                        deploy => { root.deploy(); }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // Transaction log
                    VerticalLayout {
                        spacing: Theme.space-sm;
                        Text { text: "Transaction Log"; color: Theme.text; font-size: 13px; font-weight: 600; }

                        Rectangle {
                            min-height: 100px;
                            border-radius: Theme.radius-md;
                            background: Theme.bg;
                            border-width: 1px; border-color: Theme.border-subtle;

                            Text {
                                text: "No transactions yet";
                                color: Theme.text-muted;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
