// Chat view — traditional Q&A chatbot layout
// Messages scroll in a thread as individual bubbles, input stays pinned at bottom
import { Theme } from "../theme.slint";
import { PrivacyIndicator } from "../shared/feedback.slint";
import { CitrateLoader } from "../loader/citrate_loader.slint";

export struct ChatMessageData {
    role: string,       // "user", "assistant", or "tool"
    content: string,
    tool-name: string,  // P960-A WP-A.4: populated when role=="tool"
                        // (e.g. "get_recent_blocks"); enables distinct
                        // styling + widget rendering on the UI side.
}

component MessageBubble inherits Rectangle {
    in property <string> role: "user";
    in property <string> content;
    in property <string> tool-name: "";
    callback copy-content(string);

    // Tool-role messages get distinct framing — subtle chamois border,
    // mono font for the body, and a "Tool: get_recent_blocks" header —
    // so structured chain data is visually separate from chatter.
    property <bool> is-tool: root.role == "tool";

    min-height: 36px;
    border-radius: Theme.radius-lg;
    background: root.is-tool ? Theme.bg-secondary
        : (root.role == "user" ? Theme.bg-tertiary : Theme.surface);
    border-width: root.is-tool ? 1px
        : (root.role == "assistant" ? 1px : 0px);
    border-color: root.is-tool ? Theme.warning : Theme.border-subtle;

    property <bool> copied: false;

    VerticalLayout {
        padding-top: Theme.space-sm;
        padding-bottom: Theme.space-sm;
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        spacing: Theme.space-xs;

        HorizontalLayout {
            Text {
                text: root.is-tool ? ("Tool: " + root.tool-name)
                    : (root.role == "user" ? "You" : "Citrate AI");
                color: root.is-tool ? Theme.warning
                    : (root.role == "user" ? Theme.text-muted : Theme.accent);
                font-size: 10px;
                font-weight: 600;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            // Copy button — always visible because Slint's Text
            // element doesn't support text selection. arboard handles
            // the actual clipboard write via the Rust side.
            Rectangle {
                width: 48px;
                height: 20px;
                border-radius: Theme.radius-sm;
                background: copy-touch.pressed ? Theme.bg-tertiary
                    : (copy-touch.has-hover ? Theme.bg-tertiary.brighter(0.2) : transparent);
                animate background { duration: Theme.duration-fast; }

                Text {
                    text: root.copied ? "Copied" : "Copy";
                    color: root.copied ? Theme.success : Theme.text-muted;
                    font-size: 10px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                copy-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.copy-content(root.content);
                        root.copied = true;
                        copy-reset.running = true;
                    }
                }

                copy-reset := Timer {
                    interval: 2s;
                    running: false;
                    triggered => {
                        root.copied = false;
                        copy-reset.running = false;
                    }
                }
            }
        }

        Text {
            text: root.content;
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
        }
    }
}

component ToolApprovalCard inherits Rectangle {
    in property <string> tool-name;
    in property <string> tool-description;
    in property <string> risk-level: "high";
    in property <string> tool-target: "";
    in property <string> tool-scope: "";
    callback approve;
    callback reject;

    property <color> risk-color: root.risk-level == "critical" ? Theme.error
        : root.risk-level == "high" ? Theme.warning
        : root.risk-level == "medium" ? Theme.info
        : Theme.success;

    min-height: 60px;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    border-width: 1px;
    border-color: root.risk-color;

    VerticalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-sm;

        // Header: risk dot + tool name + risk badge
        HorizontalLayout {
            spacing: Theme.space-sm;
            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.risk-color; y: 4px; }
            Text { text: "Tool: " + root.tool-name; color: root.risk-color; font-size: 12px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Rectangle {
                height: 18px; width: 50px; border-radius: Theme.radius-sm; background: root.risk-color;
                Text { text: root.risk-level; color: Theme.on-solid; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; letter-spacing: 0.5px; }
            }
        }

        // Target: what this tool will affect
        if root.tool-target != "" : HorizontalLayout {
            spacing: Theme.space-xs;
            Text { text: "Target:"; color: Theme.text-muted; font-size: 11px; font-weight: 600; }
            Text { text: root.tool-target; color: Theme.text; font-size: 11px; overflow: elide; }
        }

        // Scope: what will change
        if root.tool-scope != "" : HorizontalLayout {
            spacing: Theme.space-xs;
            Text { text: "Scope:"; color: Theme.text-muted; font-size: 11px; font-weight: 600; }
            Text { text: root.tool-scope; color: Theme.text; font-size: 11px; wrap: word-wrap; }
        }

        // Parameters
        Text { text: root.tool-description; color: Theme.text-muted; font-size: 11px; wrap: word-wrap; }

        // Action buttons
        HorizontalLayout {
            spacing: Theme.space-sm;
            Rectangle {
                height: 28px; horizontal-stretch: 1; border-radius: Theme.radius-sm;
                background: approve-touch.pressed ? Theme.success.darker(0.2) :
                            (approve-touch.has-hover ? Theme.success.brighter(0.15) : Theme.success);
                animate background { duration: Theme.duration-fast; }
                Text { text: "Allow Once"; color: Theme.on-solid; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                approve-touch := TouchArea { mouse-cursor: pointer; clicked => { root.approve(); } }
            }
            Rectangle {
                height: 28px; horizontal-stretch: 1; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.error;
                background: deny-touch.pressed ? Theme.error.with-alpha(0.3) :
                            (deny-touch.has-hover ? Theme.error.with-alpha(0.15) : transparent);
                animate background { duration: Theme.duration-fast; }
                Text { text: "Deny"; color: Theme.error; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                deny-touch := TouchArea { mouse-cursor: pointer; clicked => { root.reject(); } }
            }
        }
    }
}

export component ChatView inherits Rectangle {
    in property <bool> model-loaded: false;
    in property <string> model-name: "No model";
    in property <string> backend-type: "local"; // "local", "api", "none"
    in property <bool> thinking: false;
    in property <string> last-response: "";
    in property <string> error: "";
    in property <[ChatMessageData]> messages: [];
    in-out property <string> user-input: "";

    in property <bool> tool-pending: false;
    in property <string> tool-name: "";
    in property <string> tool-description: "";
    in property <string> tool-risk-level: "high";
    in property <string> tool-target: "";
    in property <string> tool-scope: "";

    // Tool disclosure: shows what tool executed and the result
    in property <string> tool-disclosure: "";

    // NATIVE-R1-S1 WP-5: per-facet SVG commands driving the CitrateLoader
    // thinking indicator. Fed from Rust via loader::LoaderHandle::model();
    // left empty, the loader renders the static assembled triangle.
    in property <[string]> loader-facets: [];

    callback send-message(string);
    callback approve-tool;
    callback reject-tool;
    callback copy-to-clipboard(string);
    // CIT-AGENT-9c-shell-wire-cutover follow-on: close button
    // inside the drawer. The outer header's "CLOSE CHAT" toggle
    // can be visually covered when the drawer overlays it; an
    // in-drawer X is the always-reachable dismiss path.
    callback close-clicked;

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.space-lg;
        spacing: 0px;

        // ── Header ──
        HorizontalLayout {
            height: 36px;
            spacing: Theme.space-md;

            Text { text: "Chat"; color: Theme.text; font-family: Theme.font-display; font-size: 20px; font-weight: 600; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }

            HorizontalLayout {
                spacing: Theme.space-sm;
                alignment: center;
                PrivacyIndicator { source: root.backend-type; }
                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.model-loaded ? Theme.success : Theme.text-muted; }
                Text { text: root.model-name; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; overflow: elide; max-width: 200px; }
            }

            // Close-X — always reachable dismiss button inside the drawer.
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: Theme.radius-md;
                background: close-touch.has-hover ? Theme.bg-tertiary : transparent;
                border-width: 1px;
                border-color: Theme.border;
                Text {
                    text: "✕";
                    color: Theme.text-muted;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                close-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.close-clicked(); }
                }
            }
        }

        Rectangle { height: Theme.space-sm; }

        // ── Message Thread ── (scrollable, fills available space)
        Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius-lg;
            background: Theme.bg-secondary;
            border-width: 1px;
            border-color: Theme.border-subtle;
            clip: true;

            thread := Flickable {
                // Viewport height tracks the inner layout so the Flickable scrolls
                viewport-height: thread-content.preferred-height;
                // Auto-scroll: pin to bottom so newest messages are always visible
                viewport-y: min(0px, self.height - self.viewport-height);

                thread-content := VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    // Welcome state — show when no messages exist
                    if root.messages.length == 0 && root.last-response == "" && !root.thinking : VerticalLayout {
                        alignment: center;
                        min-height: 200px;
                        spacing: Theme.space-md;

                        Text {
                            text: root.model-loaded ? "Ask me anything" : "No model loaded";
                            color: Theme.text-muted;
                            font-size: 16px;
                            font-weight: 500;
                            horizontal-alignment: center;
                        }

                        if !root.model-loaded : Text {
                            text: "Go to Settings > AI Configuration to configure a provider or download a local model.";
                            color: Theme.text-muted;
                            font-size: 12px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        if root.model-loaded : VerticalLayout {
                            spacing: Theme.space-xs;
                            Text { text: "Try:"; color: Theme.text-muted; font-size: 11px; horizontal-alignment: center; }
                            Text { text: "\"What is SALT?\""; color: Theme.accent; font-size: 12px; horizontal-alignment: center; }
                            Text { text: "\"How does GhostDAG consensus work?\""; color: Theme.accent; font-size: 12px; horizontal-alignment: center; }
                        }
                    }

                    // Conversation — individual message bubbles
                    for msg in root.messages : MessageBubble {
                        role: msg.role;
                        content: msg.content;
                        tool-name: msg.tool-name;
                        copy-content(text) => { root.copy-to-clipboard(text); }
                    }

                    // Thinking indicator — NATIVE-R1-S1 WP-5: the liquid-morph
                    // CitrateLoader replaces the old pulsing dot. WP-6 survey
                    // fix: the morph ring overflows the mark square (ring
                    // radius 52 + thickness 18 on a 100-unit viewBox), so the
                    // host must be ≥ ~1.45× the loader size — 24px in a 40px
                    // host (1.67×) keeps the full ring inside the row.
                    if root.thinking && root.error == "" : HorizontalLayout {
                        spacing: Theme.space-sm;
                        padding-left: Theme.space-sm;
                        Rectangle {
                            width: 40px;
                            height: 40px;
                            CitrateLoader {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                size: 24px;
                                color: Theme.accent;
                                running: root.thinking;
                                facet-commands: root.loader-facets;
                            }
                        }
                        Text { text: "Thinking..."; color: Theme.accent; font-size: 13px; vertical-alignment: center; }
                    }

                    // Tool disclosure: shows what tool was executed
                    if root.tool-disclosure != "" : Rectangle {
                        min-height: 28px;
                        border-radius: Theme.radius-md;
                        background: Theme.bg-tertiary;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        HorizontalLayout {
                            padding: Theme.space-sm;
                            padding-left: Theme.space-md;
                            spacing: Theme.space-sm;
                            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.info; y: 5px; }
                            Text { text: root.tool-disclosure; color: Theme.text-secondary; font-size: 11px; wrap: word-wrap; }
                        }
                    }

                    // Tool approval
                    if root.tool-pending : ToolApprovalCard {
                        tool-name: root.tool-name;
                        tool-description: root.tool-description;
                        risk-level: root.tool-risk-level;
                        tool-target: root.tool-target;
                        tool-scope: root.tool-scope;
                        approve => { root.approve-tool(); }
                        reject => { root.reject-tool(); }
                    }

                    // Error
                    if root.error != "" : Rectangle {
                        min-height: 40px;
                        border-radius: Theme.radius-md;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.error;

                        VerticalLayout {
                            padding: Theme.space-md;
                            spacing: Theme.space-xs;
                            HorizontalLayout {
                                spacing: Theme.space-sm;
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.error; y: 3px; }
                                Text { text: "Error"; color: Theme.error; font-size: 11px; font-weight: 600; }
                            }
                            Text { text: root.error; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                }
            }
        }

        Rectangle { height: Theme.space-sm; }

        // ── Input Area ── (pinned at bottom, grows with content, max 8 lines)
        Rectangle {
            min-height: 48px;
            max-height: 160px;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.bg-secondary;

            HorizontalLayout {
                padding-left: Theme.space-lg;
                padding-right: Theme.space-sm;
                padding-top: Theme.space-sm;
                padding-bottom: Theme.space-sm;
                spacing: Theme.space-sm;

                // Text input — scrollable, grows up to max-height
                Flickable {
                    horizontal-stretch: 1;
                    viewport-height: input-field.preferred-height;

                    input-field := TextInput {
                        text <=> root.user-input;
                        font-size: 14px;
                        color: Theme.text;
                        wrap: word-wrap;
                        vertical-alignment: top;
                        enabled: root.model-loaded && !root.thinking;
                        accepted => {
                            if root.user-input != "" {
                                root.send-message(root.user-input);
                                root.user-input = "";
                            }
                        }
                    }
                }

                // Send button — always visible, vertically centered
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    property <bool> can-send: root.model-loaded && !root.thinking && root.user-input != "";
                    background: can-send
                        ? (send-touch.pressed ? Theme.accent-hover.darker(0.2) :
                           (send-touch.has-hover ? Theme.accent-hover : Theme.accent))
                        : Theme.bg-tertiary;
                    animate background { duration: Theme.duration-fast; easing: ease-in-out; }

                    Text {
                        text: "↑";
                        color: root.model-loaded ? Theme.on-accent : Theme.text-muted;
                        font-size: 18px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    send-touch := TouchArea {
                        mouse-cursor: parent.can-send ? pointer : default;
                        clicked => {
                            if root.user-input != "" && root.model-loaded && !root.thinking {
                                root.send-message(root.user-input);
                                root.user-input = "";
                            }
                        }
                    }
                }
            }
        }
    }
}
