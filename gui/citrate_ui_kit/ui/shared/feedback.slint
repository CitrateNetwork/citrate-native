// Shared feedback components — LoadingButton, StatusBadge, PrivacyIndicator
import { Theme } from "../theme.slint";

/// A button that shows a spinner while working, then success/error.
/// States: idle → working → success/error → idle (auto-reset after 2s)
export component LoadingButton inherits Rectangle {
    in property <string> label;
    in property <string> state: "idle"; // "idle", "working", "success", "error"
    in property <bool> disabled: false;
    callback clicked;

    height: 36px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: root.state == "success" ? Theme.success :
                  root.state == "error" ? Theme.error :
                  (btn-touch.has-hover && !root.disabled ? Theme.accent : Theme.border);
    background: root.state == "working" ? Theme.bg-tertiary :
                root.state == "success" ? Theme.success :
                root.state == "error" ? Theme.error :
                (btn-touch.has-hover && !root.disabled ? Theme.bg-tertiary : transparent);
    opacity: root.disabled ? 0.5 : 1.0;
    animate background { duration: Theme.duration-base; easing: ease-in-out; }
    animate border-color { duration: Theme.duration-base; easing: ease-in-out; }

    HorizontalLayout {
        alignment: center;
        spacing: Theme.space-sm;

        if root.state == "working" : Text {
            text: "●";
            color: Theme.accent;
            font-size: 14px;
            animate color { duration: 600ms; easing: ease-in-out; }
        }

        Text {
            text: root.state == "success" ? "Done" :
                  root.state == "error" ? "Failed" :
                  root.state == "working" ? "Working..." :
                  root.label;
            color: root.state == "success" || root.state == "error" ? #ffffff :
                   root.state == "working" ? Theme.accent : Theme.text;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    btn-touch := TouchArea {
        clicked => {
            if !root.disabled && root.state == "idle" {
                root.clicked();
            }
        }
    }
}

/// Colored pill badge showing a status string.
export component StatusBadge inherits Rectangle {
    in property <string> text;
    in property <string> variant: "info"; // "info", "success", "warning", "error", "muted"

    height: 20px;
    min-width: 40px;
    border-radius: 10px;
    background: root.variant == "success" ? Theme.success :
                root.variant == "warning" ? Theme.warning :
                root.variant == "error" ? Theme.error :
                root.variant == "muted" ? Theme.bg-tertiary :
                Theme.info;

    Text {
        text: root.text;
        color: root.variant == "muted" ? Theme.text-muted : #ffffff;
        font-size: 9px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ============================================================================
// Press-state button primitives (Sprint P950-C, WP-C.2)
// ============================================================================
//
// The core UX fix for "I have to double-click all the buttons." These give
// INSTANT visual feedback on press — the background changes and scale dips
// slightly, so the user sees their click was registered before any async
// handler returns.

/// Primary button — filled accent color; use for main CTAs (Send, Submit).
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> disabled: false;
    in property <length> button-height: 38px;
    callback clicked;

    height: root.button-height;
    border-radius: Theme.radius-md;
    background: root.disabled ? Theme.bg-tertiary :
                (touch.pressed ? Theme.accent-hover.darker(0.15) :
                 (touch.has-hover ? Theme.accent-hover : Theme.accent));
    animate background { duration: Theme.duration-fast; }
    opacity: root.disabled ? 0.6 : 1.0;
    animate opacity { duration: Theme.duration-fast; }

    Text {
        text: root.text;
        color: root.disabled ? Theme.text-muted : #000000;
        font-size: Theme.font-size-md;
        font-weight: Theme.font-weight-semibold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: root.disabled ? default : pointer;
        clicked => {
            if (!root.disabled) {
                root.clicked();
            }
        }
    }
}

/// Secondary button — outlined; for Cancel, Back, secondary actions.
export component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> disabled: false;
    in property <length> button-height: 38px;
    callback clicked;

    height: root.button-height;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: root.disabled ? Theme.border-subtle :
                  (touch.has-hover ? Theme.accent : Theme.border);
    background: root.disabled ? transparent :
                (touch.pressed ? Theme.bg-tertiary :
                 (touch.has-hover ? Theme.bg-secondary : transparent));
    animate background { duration: Theme.duration-fast; }
    animate border-color { duration: Theme.duration-fast; }
    opacity: root.disabled ? 0.6 : 1.0;

    Text {
        text: root.text;
        color: Theme.text;
        font-size: Theme.font-size-md;
        font-weight: Theme.font-weight-medium;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: root.disabled ? default : pointer;
        clicked => {
            if (!root.disabled) {
                root.clicked();
            }
        }
    }
}

/// Generic press-state Rectangle for sites that need a non-button click
/// surface (rows, tiles, nav items, avatar bubbles). Provides the same
/// instant-feedback hover + press coloring as PrimaryButton without
/// forcing button styling.
///
/// Usage:
///   Pressable {
///       base-color: root.active ? Theme.bg-tertiary : transparent;
///       border-radius: Theme.radius-md;
///       clicked => { root.select(); }
///
///       // children go INSIDE via HorizontalLayout / VerticalLayout
///       HorizontalLayout { ... }
///   }
export component Pressable inherits Rectangle {
    in property <color> base-color: transparent;
    in property <color> hover-color: Theme.bg-tertiary;
    in property <color> pressed-color: Theme.bg-secondary;
    in property <bool> disabled: false;
    callback clicked;

    background: root.disabled ? root.base-color :
                (touch.pressed ? root.pressed-color :
                 (touch.has-hover ? root.hover-color : root.base-color));
    animate background { duration: Theme.duration-fast; }
    opacity: root.disabled ? 0.5 : 1.0;

    touch := TouchArea {
        mouse-cursor: root.disabled ? default : pointer;
        clicked => {
            if (!root.disabled) {
                root.clicked();
            }
        }
    }
}

/// Shows where data is coming from — Local, Testnet, External API, etc.
export component PrivacyIndicator inherits HorizontalLayout {
    in property <string> source: "local"; // "local", "testnet", "api", "pool"

    spacing: Theme.space-xs;
    alignment: center;

    Rectangle {
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: root.source == "local" ? Theme.success :
                    root.source == "testnet" ? Theme.periwinkle :
                    root.source == "api" ? Theme.warning :
                    root.source == "pool" ? Theme.wisteria :
                    Theme.text-muted;
    }

    Text {
        text: root.source == "local" ? "Local Only" :
              root.source == "testnet" ? "Testnet" :
              root.source == "api" ? "External API" :
              root.source == "pool" ? "Shared Pool" :
              "Unknown";
        color: Theme.text-muted;
        font-size: 9px;
        font-weight: 500;
        vertical-alignment: center;
    }
}
