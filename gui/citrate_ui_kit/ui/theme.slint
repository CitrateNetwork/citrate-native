// Citrate Design System — canonical brand tokens (Sprint NATIVE-R1-S1, WP-1/2).
//
// Source of truth: citrate-landing/src/styles/colors_and_type.css +
// citrate-explorer/src/scan/scan.css (dual-mode split). Light-first on warm
// paper; dark mode is deep evergreen — never black.
//
// Dual mode: Slint globals cannot be swapped at runtime, so every color
// token is a ternary on `dark-mode`. The Appearance setting (Settings →
// Appearance) drives `dark-mode` from Rust ("dark" → true; "light" and
// "system" → false, light is the canonical default).
//
// Typography: Space Grotesk (display), Geist (body), Cormorant (serif),
// Geist Mono (code/hashes). Bundled OFL-licensed TTFs under assets/fonts/
// — see NOTICE-fonts.md. Slint's `import` directive embeds and registers
// them at compile time so we don't depend on system fallbacks.
import "../assets/fonts/SpaceGrotesk-Variable.ttf";
import "../assets/fonts/Geist-Variable.ttf";
import "../assets/fonts/GeistMono-Variable.ttf";
import "../assets/fonts/Cormorant-Variable.ttf";

export global Theme {
    // === Mode switch — light (default) vs deep-evergreen dark ===
    in-out property <bool> dark-mode: false;

    // ========================================================================
    // Brand constants (mode-independent)
    // ========================================================================
    out property <color> citrate-green: #8ecc09;       // primary accent — citric, alive
    out property <color> citrate-green-deep: #5a8205;  // hover, AA text on cream
    out property <color> citrate-green-dark: #2f4502;  // pressed, accent text on white
    out property <color> citrate-green-tint: #e8f3c6;  // surface wash
    out property <color> citrate-yellow: #ffbd10;      // secondary accent — sun, evidence
    out property <color> citrate-yellow-deep: #c89400;
    out property <color> citrate-yellow-dark: #6e5100;
    out property <color> citrate-yellow-tint: #fff1c4;
    out property <color> deep-evergreen: #0f2a1a;      // trust anchor; data viz
    out property <color> evergreen-2: #1a3b27;

    // ========================================================================
    // Surfaces — light: warm paper / dark: deep evergreen
    // ========================================================================
    out property <color> bg: dark-mode ? #0c2216 : #f1eee6;            // canvas
    out property <color> bg-secondary: dark-mode ? #0a1c12 : #ecebe4;  // sunk wells
    out property <color> bg-tertiary: dark-mode ? #11301f : #faf8f3;   // surface — panels
    out property <color> surface: dark-mode ? #163a26 : #ffffff;       // surface-2 — cards, modals
    // Canonical aliases (same values; new code may prefer these names)
    out property <color> canvas: bg;
    out property <color> sunk: bg-secondary;
    out property <color> surface-2: surface;

    // Text ladder
    out property <color> text: dark-mode ? #edf3ea : #0e0f0c;           // text-1
    out property <color> text-secondary: dark-mode ? #aec1b0 : #555851; // text-2
    out property <color> text-muted: dark-mode ? #7a9a84 : #8a8c84;     // text-3

    // Borders
    out property <color> border: dark-mode ? rgba(205, 231, 214, 0.14) : #dbdcd5;
    out property <color> border-subtle: dark-mode ? rgba(205, 231, 214, 0.08) : #e6e5df;
    out property <color> border-strong: dark-mode ? rgba(205, 231, 214, 0.28) : #c3c4be;

    // Header band (deep evergreen in both modes)
    out property <color> header-bg: dark-mode ? #081a10 : #0f2a1a;
    out property <color> header-fg: dark-mode ? #edf3ea : #f1eee6;

    // ========================================================================
    // Accent — citrate green
    // ========================================================================
    out property <color> accent: dark-mode ? #9ad60c : #8ecc09;
    out property <color> accent-hover: dark-mode ? #b6e524 : #5a8205;   // accent-deep
    out property <color> accent-deep: dark-mode ? #b6e524 : #5a8205;
    out property <color> accent-text: dark-mode ? #a9df1a : #4f7304;    // AA text on canvas
    out property <color> accent-tint: dark-mode ? rgba(142, 204, 9, 0.14) : #e8f3c6;
    // Text/glyph color on accent-filled surfaces (green is bright in both modes)
    out property <color> on-accent: #112005;
    // Text/glyph color on solid semantic fills (success/warning/danger/info
    // buttons and badges). Semantic fills are dark inks in light mode and
    // bright in dark mode, so this flips with the mode.
    out property <color> on-solid: dark-mode ? #0c2216 : #ffffff;
    // Toggle-switch / slider knob — constant white; always rides on an
    // accent or border-colored track, never directly on the canvas.
    out property <color> knob: #ffffff;
    // Focus ring — 3px rgba(142,204,9,.35)
    out property <color> focus-ring: rgba(142, 204, 9, 0.35);
    out property <length> focus-ring-width: 3px;

    // ========================================================================
    // Semantic colors (canonical success/warning/danger/info)
    // ========================================================================
    out property <color> success: dark-mode ? #9ad60c : #4f8a05;
    out property <color> success-text: dark-mode ? #a9df1a : #4f7304;
    out property <color> success-bg: dark-mode ? rgba(142, 204, 9, 0.14) : #ecf5d4;
    out property <color> warning: dark-mode ? #ffbd10 : #b07b00;
    out property <color> warning-text: dark-mode ? #ffcf52 : #8a6200;
    out property <color> warning-bg: dark-mode ? rgba(255, 189, 16, 0.14) : #fff1c4;
    out property <color> error: dark-mode ? #e26a58 : #a72414;          // danger
    out property <color> error-text: dark-mode ? #ef8273 : #a72414;
    out property <color> error-bg: dark-mode ? rgba(167, 36, 20, 0.22) : #f6e1de;
    out property <color> info: dark-mode ? #8fbcd9 : #1b4965;
    out property <color> info-text: dark-mode ? #a8cce3 : #1b4965;
    out property <color> info-bg: dark-mode ? rgba(27, 73, 101, 0.32) : #dbe7ef;

    // Modal scrim — dims content behind dialogs/drawers
    out property <color> scrim: dark-mode ? rgba(0, 0, 0, 0.60) : rgba(14, 15, 12, 0.45);

    // Spacing (4px base)
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;
    out property <length> space-2xl: 32px;

    // Radii
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 8px;
    out property <length> radius-xl: 12px;
    out property <length> radius-full: 9999px;   // BFR-INT-5b: pill / status-chip shape

    // ========================================================================
    // Typography (Sprint P950-C, WP-C.1)
    // ========================================================================
    // Use these instead of literal px values. Sizes are ordered by visual
    // weight: xs for labels, 3xl for hero headings.
    out property <length> font-size-xs: 10px;      // Tiny labels, monospace status
    out property <length> font-size-sm: 11px;      // Secondary metadata
    out property <length> font-size-md: 13px;      // Default body
    out property <length> font-size-lg: 14px;      // Emphasized body
    out property <length> font-size-xl: 16px;      // Subheadings
    out property <length> font-size-2xl: 18px;     // Section headings
    out property <length> font-size-3xl: 24px;     // Page/hero headings

    // Weights — numeric per CSS convention
    out property <int> font-weight-regular: 400;
    out property <int> font-weight-medium: 500;
    out property <int> font-weight-semibold: 600;
    out property <int> font-weight-bold: 700;

    // Font families (NATIVE-R1-S1 WP-2 — canonical four-family system).
    // `font-body` is the default for every Text unless overridden.
    // `font-display` is for hero/page headings. `font-serif` is the
    // Cormorant editorial voice. `font-mono` is for hashes, addresses,
    // code, and any tabular figures where digit alignment matters.
    out property <string> font-display: "Space Grotesk";
    out property <string> font-body: "Geist";
    out property <string> font-serif: "Cormorant";
    out property <string> font-mono: "Geist Mono";

    // ========================================================================
    // Motion tokens (Sprint P950-C, WP-C.1)
    // ========================================================================
    // Guidelines:
    //   duration-instant — state flips that must feel immediate (focus, hover-start)
    //   duration-fast    — most press/hover transitions; the "default" choice
    //   duration-base    — tab switches, drawer slides, meaningful state changes
    //   duration-slow    — large-surface transitions, emphasis animations
    out property <duration> duration-instant: 80ms;
    out property <duration> duration-fast: 120ms;
    out property <duration> duration-base: 180ms;
    out property <duration> duration-slow: 240ms;

    // ========================================================================
    // Elevation tokens (Sprint P950-C, WP-C.1)
    // ========================================================================
    // Apply to Rectangles via drop-shadow-*. Three levels match the standard
    // elevation ladder: cards → dialogs → modals. Shadow ink is warm-black
    // in light mode, true black in dark (per scan.css shadow recipes).
    out property <color> shadow-color-sm: dark-mode ? rgba(0, 0, 0, 0.35) : rgba(14, 15, 12, 0.18);
    out property <color> shadow-color-md: dark-mode ? rgba(0, 0, 0, 0.45) : rgba(14, 15, 12, 0.22);
    out property <color> shadow-color-lg: dark-mode ? rgba(0, 0, 0, 0.60) : rgba(14, 15, 12, 0.30);
    out property <length> shadow-offset-sm: 2px;
    out property <length> shadow-offset-md: 4px;
    out property <length> shadow-offset-lg: 8px;
    out property <length> shadow-blur-sm: 4px;
    out property <length> shadow-blur-md: 8px;
    out property <length> shadow-blur-lg: 16px;

    // Hover scale — subtle lift on interactive surfaces. 1.02 is the
    // sweet spot; less is imperceptible, more feels jumpy.
    out property <float> scale-hover: 1.02;
    out property <float> scale-pressed: 0.98;

    // Layout
    out property <length> sidebar-width: 220px;
    out property <length> sidebar-collapsed: 52px;
    out property <length> status-bar-height: 32px;
}
